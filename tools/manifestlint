#!/usr/bin/env python3
# manifestlint — hold the workspace's member manifests to the workspace table,
# and the justfile's list of tool-side members to the workspace.
#
# The root Cargo.toml's [workspace.dependencies] is the version of record for
# every dependency in the workspace: member manifests inherit an entry with
# `workspace = true`, adding only what cargo permits or requires at the
# member — feature selections (`features`, and `default-features = true` to
# widen a table default of false; cargo itself rejects the narrowing
# direction) and the `optional` flag. Everything else a member could say —
# a bare version string, `version`, `path`, `git`, `branch`, `rev`, `tag`,
# `registry`, `package` — restates or contradicts the table, and such a
# restatement drifts silently when the table moves.
#
# Cargo offers no native check: `cargo metadata` resolves inheritance before
# reporting, so an inherited entry and a locally-versioned one are
# indistinguishable in its output, and no cargo lint reads manifests. Cargo
# does own member *discovery*, so the tool asks `cargo metadata --no-deps`
# which manifests belong to the workspace and reads each with the standard
# library's TOML parser. Detached workspaces (the fuzz targets, with their
# own Cargo.lock) are separate workspaces with their own tables, outside
# this tool's scope.
#
# The justfile's `tool_members` is the one list of the workspace's tool-side
# members, as the `--exclude NAME` pairs its workspace-wide cargo commands
# pass. Cargo accepts an exclusion naming no member with only a warning,
# still compiles an excluded member that an included one depends on, and
# cannot tell a tool from any other member, so a stale name, an unlisted
# dependent, or a tool dropped from the list would each bring the tools back
# into the ordinary legs without failing anything. The tool evaluates the
# variable with `just` and holds it to the same `cargo metadata` view: every
# name a member, none a default member (which a plain cargo command at the
# root builds), none listed twice, no unlisted member depending on a listed
# one, and no unlisted member declaring a tool-only dependency.
#
# Usage:
#   manifestlint --self-test   # pin the declarations and exclusions the
#                              # rules accept and reject
#   manifestlint               # check the workspace containing the current
#                              # directory
#
# Exits non-zero if any violation is found, printing `manifest: [table] name`
# or `justfile: tool_members` plus what offends, the way the rest of the gate
# names its failures.

import json
import subprocess
import sys
import tomllib
from pathlib import Path

# What a member entry may say beside `workspace = true`. `features` and
# `default-features` widen the table's feature base (cargo rejects a member
# narrowing `default-features` below the table's), and cargo requires
# `optional` at the member whenever the dependency backs a feature.
ALLOWED_KEYS = {"workspace", "features", "optional", "default-features"}

# The dependency tables a manifest may carry; each is also legal under a
# `[target.'…'.<table>]` heading.
DEP_TABLES = ("dependencies", "dev-dependencies", "build-dependencies")

# Dependencies only tool-side members may declare: the reason they are kept
# out of the ordinary legs. Membership in `tool_members` is otherwise a
# judgment no manifest records, so this is what catches a Wasmtime-bearing
# tool dropped from the list.
TOOL_ONLY_DEPENDENCIES = {"wasmtime"}


def violations(manifest):
    """Yield `(table, name, reason)` for every dependency entry that is not
    a workspace inheritance plus allowed member-side additions. The
    manifest's own `[workspace.dependencies]` table is the version of
    record, not a member declaration, and is never scanned."""
    tables = []
    for kind in DEP_TABLES:
        if kind in manifest:
            tables.append((kind, manifest[kind]))
        for target, cfg in manifest.get("target", {}).items():
            if kind in cfg:
                tables.append((f"target.{target}.{kind}", cfg[kind]))
    for table, deps in tables:
        for name, spec in deps.items():
            if not isinstance(spec, dict):
                yield table, name, (
                    f"declares {spec!r} instead of inheriting the workspace entry"
                )
            elif spec.get("workspace") is not True:
                yield table, name, "does not inherit the workspace entry (workspace = true)"
            else:
                extra = sorted(set(spec) - ALLOWED_KEYS)
                if extra:
                    yield table, name, (
                        f"declares {', '.join(extra)} beside the workspace entry"
                    )


def exclusion_violations(tokens, members):
    """Yield `(name, reason)` for every way the tool-member exclusions
    disagree with the workspace, `name` being the member at fault (`None`
    when the list itself is malformed).

    `tokens` is the exclusion list as cargo receives it, split on
    whitespace. `members` maps each member's package name to a triple:
    whether it is a default member, the names of the members it depends on,
    and the names of the other crates it depends on (normal, build, or dev
    dependencies alike). Only cargo's own spelling, `--exclude NAME` pairs,
    is understood; anything else is reported rather than guessed at."""
    flags, names = tokens[0::2], tokens[1::2]
    if len(tokens) % 2 or any(flag != "--exclude" for flag in flags):
        yield None, f"is not a sequence of `--exclude NAME` pairs: {' '.join(tokens)!r}"
        return
    listed = set()
    for name in names:
        if name in listed:
            yield name, f"lists {name} more than once"
        listed.add(name)
        if name not in members:
            yield name, f"lists {name}, which is no workspace member, so cargo ignores its exclusion"
        elif members[name][0]:
            yield name, f"lists {name}, a default member, which a plain cargo command at the root builds"
    for name, (_, member_deps, crate_deps) in sorted(members.items()):
        if name not in listed:
            for dep in sorted(member_deps & listed):
                yield name, (
                    f"leaves out {name}, which depends on the listed {dep}, "
                    f"so the workspace-wide legs still compile {dep}"
                )
            for dep in sorted(crate_deps & TOOL_ONLY_DEPENDENCIES):
                yield name, (
                    f"leaves out {name}, which depends on the tool-only {dep}, "
                    f"so the workspace-wide legs compile {dep}"
                )


def cargo_metadata():
    """The enclosing workspace as `cargo metadata --no-deps` reports it."""
    # cargo's stderr passes through, so a discovery failure (a manifest
    # cargo itself rejects, say) surfaces as cargo's own diagnostic.
    return json.loads(
        subprocess.run(
            ["cargo", "metadata", "--no-deps", "--format-version", "1"],
            check=True,
            stdout=subprocess.PIPE,
        ).stdout
    )


def member_manifests(metadata):
    """Every manifest cargo considers a member of the workspace."""
    return sorted(Path(package["manifest_path"]) for package in metadata["packages"])


def workspace_members(metadata):
    """Map each member's package name to whether it is a default member, the
    names of the members it declares dependencies on, and the names of the
    other crates it declares dependencies on: the shape
    `exclusion_violations` reads. A dependency is on a member when it
    carries a `path`, since every path dependency in this workspace is a
    member."""
    packages = {package["id"]: package for package in metadata["packages"]}
    defaults = set(metadata["workspace_default_members"])
    members = {}
    for id in metadata["workspace_members"]:
        deps = packages[id]["dependencies"]
        members[packages[id]["name"]] = (
            id in defaults,
            {dep["name"] for dep in deps if "path" in dep},
            {dep["name"] for dep in deps if "path" not in dep},
        )
    return members


def tool_member_tokens(metadata):
    """The justfile's `tool_members`, evaluated by `just` itself, split on
    whitespace. A renamed or deleted variable fails here, by `just`'s own
    diagnostic, rather than leaving nothing to check."""
    root = Path(metadata["workspace_root"])
    return subprocess.run(
        [
            "just",
            "--justfile",
            str(root / "justfile"),
            "--working-directory",
            str(root),
            "--evaluate",
            "tool_members",
        ],
        check=True,
        stdout=subprocess.PIPE,
        text=True,
    ).stdout.split()


def check(paths):
    """Print every violation in `paths`, returning how many were found."""
    found = 0
    for path in paths:
        with open(path, "rb") as f:
            manifest = tomllib.load(f)
        for table, name, reason in violations(manifest):
            print(f"{path}: [{table}] {name} {reason}")
            found += 1
    return found


def check_exclusions(tokens, members):
    """Print every violation of the tool-member list, returning how many
    were found."""
    found = 0
    for _, reason in exclusion_violations(tokens, members):
        print(f"justfile: tool_members {reason}")
        found += 1
    return found


def self_test():
    """Pin the declarations and exclusions the rules accept and reject: each
    fixture must fail (or pass) for exactly the entry it encodes."""
    cases = [
        # The convention's shape: inherit, adding only feature selections
        # and optional flags.
        (
            """
            [dependencies]
            a = { workspace = true }
            b = { workspace = true, features = ["derive"], optional = true }
            c = { workspace = true, default-features = true }
            """,
            [],
        ),
        # A bare version string bypasses the table entirely.
        ("[dependencies]\na = \"1\"", [("dependencies", "a")]),
        # A member-local version, even one matching the table today, drifts
        # silently when the table moves.
        (
            "[dev-dependencies]\na = { version = \"1\" }",
            [("dev-dependencies", "a")],
        ),
        # Inheriting and then naming another source contradicts the table.
        (
            "[dependencies]\na = { workspace = true, path = \"../a\" }",
            [("dependencies", "a")],
        ),
        (
            "[build-dependencies]\na = { workspace = true, git = \"https://x\" }",
            [("build-dependencies", "a")],
        ),
        # workspace = false is spelled inheritance but is not one.
        ("[dependencies]\na = { workspace = false }", [("dependencies", "a")]),
        # Target-specific tables carry the same rule, named by their heading.
        (
            "[target.'cfg(unix)'.dependencies]\na = \"1\"",
            ("target.cfg(unix).dependencies", "a"),
        ),
        # The workspace table itself is the version of record, never a
        # member declaration: entries there carry versions by design.
        ("[workspace.dependencies]\na = \"1\"", []),
    ]
    for source, expected in cases:
        if isinstance(expected, tuple):
            expected = [expected]
        actual = [(table, name) for table, name, _ in violations(tomllib.loads(source))]
        if actual != expected:
            raise AssertionError(f"expected {expected}, got {actual} for:\n{source}")

    # A workspace like this one: a default root package, a production crate
    # it depends on, a Wasmtime harness, and a tool built on the harness.
    members = {
        "root": (True, {"core"}, set()),
        "core": (False, set(), {"serde"}),
        "tool": (False, {"core"}, {"wasmtime"}),
        "tool-user": (False, {"tool"}, set()),
    }
    exclusion_cases = [
        # Both tools listed, nothing else: the exclusions are sound.
        ("--exclude tool --exclude tool-user", []),
        # A name cargo would only warn about.
        ("--exclude tool --exclude tool-user --exclude gone", ["gone"]),
        # A repeated name.
        ("--exclude tool --exclude tool --exclude tool-user", ["tool"]),
        # A default member: plain cargo at the root still builds it.
        ("--exclude root --exclude tool --exclude tool-user", ["root"]),
        # A listed member an unlisted one depends on is still compiled.
        ("--exclude tool-user --exclude tool --exclude core", ["root"]),
        # A Wasmtime-bearing tool dropped from the list is compiled by the
        # ordinary legs, and so is everything built on it.
        ("--exclude tool-user", ["tool"]),
        ("", ["tool"]),
        # Only `--exclude NAME` pairs are understood, never guessed at.
        ("--exclude tool tool-user", [None]),
        ("-p tool", [None]),
    ]
    for source, expected in exclusion_cases:
        actual = [name for name, _ in exclusion_violations(source.split(), members)]
        if actual != expected:
            raise AssertionError(f"expected {expected}, got {actual} for {source!r}")
    print("manifestlint: self-test ok")


def main():
    if sys.argv[1:] == ["--self-test"]:
        self_test()
        return 0
    if sys.argv[1:]:
        print("usage: manifestlint [--self-test]", file=sys.stderr)
        return 2
    metadata = cargo_metadata()
    found = check(member_manifests(metadata))
    found += check_exclusions(tool_member_tokens(metadata), workspace_members(metadata))
    return 1 if found else 0


if __name__ == "__main__":
    sys.exit(main())
