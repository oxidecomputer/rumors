#!/usr/bin/env python3
# manifestlint — hold the workspace's member manifests to the workspace table,
# and its tool-side members to the default members and nextest's default
# filter.
#
# The root Cargo.toml's [workspace.dependencies] is the version of record for
# every dependency in the workspace: member manifests inherit an entry with
# `workspace = true`, adding only what cargo permits or requires at the
# member — feature selections (`features`, and `default-features = true` to
# widen a table default of false; cargo itself rejects the narrowing
# direction) and the `optional` flag. Everything else a member could say —
# a bare version string, `version`, `path`, `git`, `branch`, `rev`, `tag`,
# `registry`, `package` — restates or contradicts the table, and such a
# restatement drifts silently when the table moves.
#
# Cargo offers no native check: `cargo metadata` resolves inheritance before
# reporting, so an inherited entry and a locally-versioned one are
# indistinguishable in its output, and no cargo lint reads manifests. Cargo
# does own member *discovery*, so the tool asks `cargo metadata --no-deps`
# which manifests belong to the workspace and reads each with the standard
# library's TOML parser. Detached workspaces (the fuzz targets, with their
# own Cargo.lock) are separate workspaces with their own tables, outside
# this tool's scope.
#
# The root Cargo.toml's `default-members` divides the production crates from
# the tool-side members, every member it leaves out, which reach tooling the
# production crates never need (Wasmtime above all) and run only through
# their own justfile recipes. Plain cargo at the root, and so every
# workspace-wide justfile recipe, selects the default members alone, but
# cargo still compiles any member a selected one depends on, and cannot tell
# a tool from any other member. So no default member may depend on a
# tool-side member or declare a tool-only dependency: either would bring the
# tooling back into the ordinary legs without failing anything.
#
# A bare `cargo nextest run --workspace` selects every member, so
# `.config/nextest.toml`'s default filter keeps the tools' tests out of it,
# naming each tool-side member as a `package(NAME)` term and each resource
# instrument among the default members' test binaries as a
# `binary_id(PACKAGE::TEST)` term. That filter is a second list of the tools,
# so the tool holds it to the first: its package terms name exactly the
# tool-side members, each once, and each binary term names an integration
# test of a default member. Only that spelling (`not (` and `)` around terms
# joined by `|`) is understood; anything else is reported rather than
# guessed at.
#
# Usage:
#   manifestlint --self-test   # pin the declarations, default members, and
#                              # filters the rules accept and reject
#   manifestlint               # check the workspace containing the current
#                              # directory
#
# Exits non-zero if any violation is found, printing `manifest: [table] name`,
# `Cargo.toml: default-members`, or `.config/nextest.toml: default-filter`
# plus what offends, the way the rest of the gate names its failures.

import json
import re
import subprocess
import sys
import tomllib
from pathlib import Path
from typing import NamedTuple

# What a member entry may say beside `workspace = true`. `features` and
# `default-features` widen the table's feature base (cargo rejects a member
# narrowing `default-features` below the table's), and cargo requires
# `optional` at the member whenever the dependency backs a feature.
ALLOWED_KEYS = {"workspace", "features", "optional", "default-features"}

# The dependency tables a manifest may carry; each is also legal under a
# `[target.'…'.<table>]` heading.
DEP_TABLES = ("dependencies", "dev-dependencies", "build-dependencies")

# Dependencies only tool-side members may declare: the reason they are kept
# out of the ordinary legs. Being a tool is otherwise a judgment no manifest
# records, so this is what catches a Wasmtime-bearing crate added to the
# default members.
TOOL_ONLY_DEPENDENCIES = {"wasmtime"}

# One term of nextest's default filter, in the spelling the tool understands.
FILTER_TERM = re.compile(
    r"package\((?P<package>[A-Za-z0-9_-]+)\)"
    r"|binary_id\((?P<binary_package>[A-Za-z0-9_-]+)::(?P<test>[A-Za-z0-9_-]+)\)"
)


class Member(NamedTuple):
    """What the tool-side rules need to know of one workspace member."""

    # Whether the member is a default member, which plain cargo selects.
    default: bool
    # The names of the members it declares dependencies on.
    member_deps: set
    # The names of the other crates it declares dependencies on.
    crate_deps: set
    # The names of its integration test targets.
    tests: set


def violations(manifest):
    """Yield `(table, name, reason)` for every dependency entry that is not
    a workspace inheritance plus allowed member-side additions. The
    manifest's own `[workspace.dependencies]` table is the version of
    record, not a member declaration, and is never scanned."""
    tables = []
    for kind in DEP_TABLES:
        if kind in manifest:
            tables.append((kind, manifest[kind]))
        for target, cfg in manifest.get("target", {}).items():
            if kind in cfg:
                tables.append((f"target.{target}.{kind}", cfg[kind]))
    for table, deps in tables:
        for name, spec in deps.items():
            if not isinstance(spec, dict):
                yield table, name, (
                    f"declares {spec!r} instead of inheriting the workspace entry"
                )
            elif spec.get("workspace") is not True:
                yield table, name, "does not inherit the workspace entry (workspace = true)"
            else:
                extra = sorted(set(spec) - ALLOWED_KEYS)
                if extra:
                    yield table, name, (
                        f"declares {', '.join(extra)} beside the workspace entry"
                    )


def default_member_violations(members):
    """Yield `(name, reason)` for every default member that would bring a
    tool-side member's tooling into plain cargo's selection. `members` maps
    each member's package name to its `Member`."""
    tools = {name for name, member in members.items() if not member.default}
    for name, member in sorted(members.items()):
        if member.default:
            for dep in sorted(member.member_deps & tools):
                yield name, (
                    f"includes {name}, which depends on the tool-side {dep}, "
                    f"so plain cargo compiles {dep}"
                )
            for dep in sorted(member.crate_deps & TOOL_ONLY_DEPENDENCIES):
                yield name, (
                    f"includes {name}, which depends on the tool-only {dep}, "
                    f"so plain cargo compiles {dep}"
                )


def filter_violations(expression, members):
    """Yield `(name, reason)` for every way nextest's default filter
    disagrees with the default members, `name` being the member at fault
    (`None` when the filter itself is malformed).

    `expression` is the filter as nextest reads it, or `None` when the
    profile sets none, which excludes nothing."""
    terms = []
    if expression is not None:
        body = re.fullmatch(r"not\((.*)\)", "".join(expression.split()))
        if body is None:
            yield None, f"is not `not (TERM | ...)`: {expression.strip()!r}"
            return
        for text in body.group(1).split("|"):
            term = FILTER_TERM.fullmatch(text)
            if term is None:
                yield None, f"has a term that is not `package(NAME)` or `binary_id(PACKAGE::TEST)`: {text!r}"
                return
            terms.append(term)
    named = set()
    for term in terms:
        if term["package"] is not None:
            name = term["package"]
            if name in named:
                yield name, f"names package({name}) more than once"
            named.add(name)
            if name not in members:
                yield name, f"names package({name}), which is no workspace member"
            elif members[name].default:
                yield name, (
                    f"names package({name}), a default member, whose tests a plain "
                    f"nextest run must reach"
                )
        else:
            name, test = term["binary_package"], term["test"]
            if name not in members or not members[name].default:
                yield name, f"names binary_id({name}::{test}), which is no default member's binary"
            elif test not in members[name].tests:
                yield name, f"names binary_id({name}::{test}), which is no integration test of {name}"
    for name, member in sorted(members.items()):
        if not member.default and name not in named:
            yield name, (
                f"leaves out the tool-side {name}, so a bare "
                f"`cargo nextest run --workspace` runs its tests"
            )


def cargo_metadata():
    """The enclosing workspace as `cargo metadata --no-deps` reports it."""
    # cargo's stderr passes through, so a discovery failure (a manifest
    # cargo itself rejects, say) surfaces as cargo's own diagnostic.
    return json.loads(
        subprocess.run(
            ["cargo", "metadata", "--no-deps", "--format-version", "1"],
            check=True,
            stdout=subprocess.PIPE,
        ).stdout
    )


def member_manifests(metadata):
    """Every manifest cargo considers a member of the workspace."""
    return sorted(Path(package["manifest_path"]) for package in metadata["packages"])


def workspace_members(metadata):
    """Map each member's package name to its `Member`. A dependency is on a
    member when it carries a `path`, since every path dependency in this
    workspace is a member."""
    packages = {package["id"]: package for package in metadata["packages"]}
    defaults = set(metadata["workspace_default_members"])
    members = {}
    for id in metadata["workspace_members"]:
        deps = packages[id]["dependencies"]
        members[packages[id]["name"]] = Member(
            default=id in defaults,
            member_deps={dep["name"] for dep in deps if "path" in dep},
            crate_deps={dep["name"] for dep in deps if "path" not in dep},
            tests={
                target["name"]
                for target in packages[id]["targets"]
                if "test" in target["kind"]
            },
        )
    return members


def default_filter(metadata):
    """The default profile's `default-filter` from the workspace's
    `.config/nextest.toml`, or `None` when it sets none. A missing file
    fails here rather than leaving nothing to check."""
    path = Path(metadata["workspace_root"]) / ".config" / "nextest.toml"
    with open(path, "rb") as f:
        config = tomllib.load(f)
    return config.get("profile", {}).get("default", {}).get("default-filter")


def check(paths):
    """Print every violation in `paths`, returning how many were found."""
    found = 0
    for path in paths:
        with open(path, "rb") as f:
            manifest = tomllib.load(f)
        for table, name, reason in violations(manifest):
            print(f"{path}: [{table}] {name} {reason}")
            found += 1
    return found


def check_tools(expression, members):
    """Print every violation of the tool-side rules, returning how many were
    found."""
    found = 0
    for _, reason in default_member_violations(members):
        print(f"Cargo.toml: default-members {reason}")
        found += 1
    for _, reason in filter_violations(expression, members):
        print(f".config/nextest.toml: default-filter {reason}")
        found += 1
    return found


def self_test():
    """Pin the declarations, default members, and filters the rules accept
    and reject: each fixture must fail (or pass) for exactly the entry it
    encodes."""
    cases = [
        # The convention's shape: inherit, adding only feature selections
        # and optional flags.
        (
            """
            [dependencies]
            a.workspace = true
            b = { workspace = true, features = ["derive"], optional = true }
            c = { workspace = true, default-features = true }
            """,
            [],
        ),
        # A bare version string bypasses the table entirely.
        ("[dependencies]\na = \"1\"", [("dependencies", "a")]),
        # A member-local version, even one matching the table today, drifts
        # silently when the table moves.
        (
            "[dev-dependencies]\na = { version = \"1\" }",
            [("dev-dependencies", "a")],
        ),
        # Inheriting and then naming another source contradicts the table.
        (
            "[dependencies]\na = { workspace = true, path = \"../a\" }",
            [("dependencies", "a")],
        ),
        (
            "[build-dependencies]\na = { workspace = true, git = \"https://x\" }",
            [("build-dependencies", "a")],
        ),
        # workspace = false is spelled inheritance but is not one.
        ("[dependencies]\na = { workspace = false }", [("dependencies", "a")]),
        # Target-specific tables carry the same rule, named by their heading.
        (
            "[target.'cfg(unix)'.dependencies]\na = \"1\"",
            ("target.cfg(unix).dependencies", "a"),
        ),
        # The workspace table itself is the version of record, never a
        # member declaration: entries there carry versions by design.
        ("[workspace.dependencies]\na = \"1\"", []),
    ]
    for source, expected in cases:
        if isinstance(expected, tuple):
            expected = [expected]
        actual = [(table, name) for table, name, _ in violations(tomllib.loads(source))]
        if actual != expected:
            raise AssertionError(f"expected {expected}, got {actual} for:\n{source}")

    # A workspace like this one: a default root package and the production
    # crate it depends on, one carrying a resource-instrument test, beside a
    # Wasmtime harness and a tool built on the harness.
    def member(default, member_deps=(), crate_deps=(), tests=()):
        return Member(default, set(member_deps), set(crate_deps), set(tests))

    members = {
        "root": member(True, {"core"}),
        "core": member(True, (), {"serde"}, {"board_smoke", "laws"}),
        "tool": member(False, {"core"}, {"wasmtime"}),
        "tool-user": member(False, {"tool"}),
    }
    # The default members are sound: no default member reaches a tool.
    actual = [name for name, _ in default_member_violations(members)]
    if actual != []:
        raise AssertionError(f"expected no default-member violations, got {actual}")
    default_cases = [
        # A default member depending on a tool brings the tool into plain cargo.
        ({"root": member(True, {"core", "tool"})}, ["root"]),
        # So does a Wasmtime-bearing crate made a default member.
        # A tool may depend on a default member, so `tool-user` is fine.
        ({"tool": member(True, {"core"}, {"wasmtime"})}, ["tool"]),
    ]
    for change, expected in default_cases:
        actual = [name for name, _ in default_member_violations({**members, **change})]
        if actual != expected:
            raise AssertionError(f"expected {expected}, got {actual} for {change}")

    filter_cases = [
        # Both tools named and one instrument binary: the filter is sound,
        # whatever its whitespace.
        ("not (package(tool) | package(tool-user) | binary_id(core::board_smoke))", []),
        ("\nnot (\n    package(tool)\n    | package(tool-user)\n)\n", []),
        # A name that is no member.
        ("not (package(tool) | package(tool-user) | package(gone))", ["gone"]),
        # A repeated name.
        ("not (package(tool) | package(tool) | package(tool-user))", ["tool"]),
        # A default member's tests must run in a plain nextest run.
        ("not (package(root) | package(tool) | package(tool-user))", ["root"]),
        # A tool left out runs in a bare --workspace run, and so does every
        # tool when the profile sets no filter.
        ("not (package(tool-user))", ["tool"]),
        (None, ["tool", "tool-user"]),
        # A binary term must name an integration test of a default member.
        ("not (package(tool) | package(tool-user) | binary_id(core::gone))", ["core"]),
        ("not (package(tool) | package(tool-user) | binary_id(tool::board_smoke))", ["tool"]),
        # Only the documented spelling is understood, never guessed at.
        ("package(tool) | package(tool-user)", [None]),
        ("not (package(tool) | package(tool-user) | test(slow))", [None]),
        ("not (package(tool) & package(tool-user))", [None]),
    ]
    for expression, expected in filter_cases:
        actual = [name for name, _ in filter_violations(expression, members)]
        if actual != expected:
            raise AssertionError(f"expected {expected}, got {actual} for {expression!r}")
    print("manifestlint: self-test ok")


def main():
    if sys.argv[1:] == ["--self-test"]:
        self_test()
        return 0
    if sys.argv[1:]:
        print("usage: manifestlint [--self-test]", file=sys.stderr)
        return 2
    metadata = cargo_metadata()
    found = check(member_manifests(metadata))
    found += check_tools(default_filter(metadata), workspace_members(metadata))
    return 1 if found else 0


if __name__ == "__main__":
    sys.exit(main())
