+/// The heap bytes `bytes::Bytes` adds beside an adopted vector whose capacity
+/// exceeds its length: a shared header holding a pointer, a capacity, and a
+/// reference count.
+const SHARED_HEADER_BYTES: usize = 3 * size_of::<usize>();
+
 /// Mutable bytes with an explicit live bit length.
 ///
 /// Equality compares bit content bytewise because unused bits are always zero.
@@ -296,9 +301,28 @@ impl BitsWriter {
         self.mask_tail();
     }
 
-    /// Seal the completed stream into immutable canonical storage.
+    /// Seal the completed stream into immutable canonical storage that keeps
+    /// at most twice the stream's encoded length allocated.
+    ///
+    /// Domain writers reserve for their inputs' worst case, and
+    /// normalization can collapse the result far below that reservation:
+    /// joining a deep party with its complement yields one byte from a buffer
+    /// sized for both operands. Sealing the reservation as it stands would
+    /// keep it alive for as long as the result lives.
+    ///
+    /// `Bytes` adopts a vector with spare capacity behind a separate shared
+    /// header, so such a stream keeps its whole capacity plus that header.
+    /// We release the slack when the two together exceed the stream itself.
+    /// The release is a shrinking reallocation, which a stream within that
+    /// bound never pays. A released buffer carries no header until its first
+    /// clone allocates one.
     pub(crate) fn finalize(mut self) -> Bits {
         self.seal_padding();
+        let len = self.bytes.len();
+        let slack = self.bytes.capacity() - len;
+        if slack > 0 && slack + SHARED_HEADER_BYTES > len {
+            self.bytes.shrink_to_fit();
+        }
         Bits::from_canonical(Bytes::from(self.bytes))
     }
 
