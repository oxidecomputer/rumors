+// ───────────────────────────── result retention ─────────────────────────────
+
+/// The deepest operand the retention families build.
+const MAX_RETENTION_DEPTH: usize = 2_048;
+
+/// Describe how `party` breaks the retention bound, if it keeps alive more
+/// than twice its encoded bytes.
+///
+/// Writers reserve storage for their operands, and a result that collapses
+/// below that reservation must not keep it. The seed's static storage keeps
+/// no heap at all. The caller must already have dropped every other value
+/// sharing the result's buffer. The families collect every case's excess
+/// before asserting, so one failure reports each operation that retains too
+/// much.
+fn retention_excess(case: &str, party: Party) -> Option<String> {
+    let encoded = party.as_bytes().len();
+    let retained = if party.0.ptr_eq(&Party::seed().0) {
+        0
+    } else {
+        party.0.allocation_capacity()
+    };
+    (retained > 2 * encoded)
+        .then(|| format!("{case}: a {encoded}-byte party keeps a {retained}-byte allocation alive"))
+}
+
+proptest! {
+    /// Joining the leftmost `2^-depth` cell with its complement collapses to
+    /// the one-byte seed, and the seed retains at most twice its encoding
+    /// although `join` and `join_all` reserve room for both operands.
+    #[test]
+    fn collapsing_join_retains_at_most_twice_its_encoding(
+        depth in 1..=MAX_RETENTION_DEPTH,
+    ) {
+        let cell = || Party::from_test_bits(constructed::leftmost(depth));
+        let complement = || Party::from_test_bits(constructed::complement_leftmost(depth));
+        let mut excess = Vec::new();
+
+        let mut joined = cell();
+        joined.join(complement()).expect("a cell and its complement are disjoint");
+        prop_assert!(joined.is_seed());
+        excess.extend(retention_excess("join", joined));
+
+        let mut folded = cell();
+        folded.join_all([complement()]).expect("a cell and its complement are disjoint");
+        prop_assert!(folded.is_seed());
+        excess.extend(retention_excess("join_all", folded));
+
+        prop_assert!(excess.is_empty(), "{}", excess.join("; "));
+    }
+
+    /// Removing the rightmost `2^-depth` cell from `[0, 1/2) ∪ cell` leaves
+    /// the one-byte left half, which retains at most twice its encoding
+    /// although `without` reserves room for both operands.
+    #[test]
+    fn collapsing_difference_retains_at_most_twice_its_encoding(
+        depth in 2..=MAX_RETENTION_DEPTH,
+    ) {
+        let cell = |depth| constructed::spine(depth, false, constructed::full());
+        let half_and_cell = Party::from_test_bits(constructed::node(
+            Some(&constructed::full()),
+            Some(&cell(depth - 1)),
+        ));
+
+        let half = half_and_cell
+            .without(&Party::from_test_bits(cell(depth)))
+            .expect("the left half remains");
+        prop_assert_eq!(&half, &Party::from_test_bits(constructed::leftmost(1)));
+        let excess = retention_excess("without", half);
+        prop_assert!(excess.is_none(), "{}", excess.unwrap_or_default());
+    }
+
