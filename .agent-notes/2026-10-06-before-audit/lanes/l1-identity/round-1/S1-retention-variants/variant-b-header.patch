+// ───────────────────────────── result retention ─────────────────────────────
+
+/// The deepest event tree the retention families build.
+const MAX_RETENTION_DEPTH: usize = 2_048;
+
+/// The rightmost `2^-depth` cell of party space.
+fn rightmost_cell(depth: usize) -> Party {
+    let mut bits = BitsWriter::new();
+    for _ in 0..depth {
+        bits.push(false);
+        bits.push(true);
+    }
+    bits.push(false);
+    bits.push(false);
+    Party::from_test_bits(bits)
+}
+
+/// `base` events everywhere, and two more on the rightmost `2^-depth` cell:
+/// an event tree as deep as the cell.
+fn deep_bump(base: u64, depth: usize) -> Version {
+    let mut version = uniform(base);
+    version.ticks(&rightmost_cell(depth), 2u8);
+    version
+}
+
+/// Describe how `version` breaks the retention bound, if it keeps alive more
+/// than twice its encoded bytes.
+///
+/// Writers reserve storage for their operands, and a result that collapses
+/// below that reservation must not keep it. The empty version's static
+/// storage keeps no heap at all. The caller must already have dropped every
+/// other value sharing the result's buffer. The families collect every case's
+/// excess before asserting, so one failure reports each operation that
+/// retains too much.
+fn retention_excess(case: &str, version: Version) -> Option<String> {
+    let encoded = version.as_bytes().len();
+    let retained = if version.ptr_eq(&Version::new()) {
+        0
+    } else {
+        version.0.allocation_capacity()
+    };
+    (retained > 2 * encoded).then(|| {
+        format!("{case}: a {encoded}-byte version keeps a {retained}-byte allocation alive")
+    })
+}
+
+proptest! {
+    /// Each operation that collapses a deep event tree to one leaf returns a
+    /// result retaining at most twice its encoding.
+    ///
+    /// The tree collapses when joined with a uniform version above it, when
+    /// met with a uniform version below it, and when ticked by the seed. The
+    /// lattice writers reserve room for both operands, and the tick writers
+    /// for the whole input tree.
+    #[test]
+    fn collapsing_version_results_retain_at_most_twice_their_encoding(
+        depth in 1..=MAX_RETENTION_DEPTH,
+    ) {
+        let mut excess = Vec::new();
+
+        let join = &deep_bump(0, depth) | &uniform(3u8);
+        prop_assert_eq!(&join, &uniform(3u8));
+        excess.extend(retention_excess("join", join));
+
+        let join_all = deep_bump(0, depth).join_all([uniform(3u8)]);
+        prop_assert_eq!(&join_all, &uniform(3u8));
+        excess.extend(retention_excess("join_all", join_all));
+
+        let meet = &deep_bump(1, depth) & &uniform(1u8);
+        prop_assert_eq!(&meet, &uniform(1u8));
+        excess.extend(retention_excess("meet", meet));
+
+        let meet_all = deep_bump(1, depth).meet_all([uniform(1u8)]);
+        prop_assert_eq!(&meet_all, &uniform(1u8));
+        excess.extend(retention_excess("meet_all", meet_all));
+
+        let mut ticked = deep_bump(0, depth);
+        ticked.tick(&Party::seed());
+        prop_assert_eq!(&ticked, &uniform(2u8));
+        excess.extend(retention_excess("tick", ticked));
+
+        prop_assert!(excess.is_empty(), "{}", excess.join("; "));
+    }
+
+    /// Every version that the lattice operations, `tick`, `ticks`, and
+    /// projection build retains at most twice its encoding, over arbitrary
+    /// operands.
+    #[test]
+    fn built_versions_retain_at_most_twice_their_encoding(
+        oa in arb_oracle_version(),
+        ob in arb_oracle_version(),
+        party in arb_oracle_party_nonempty(),
+        count in 0u64..24,
+    ) {
+        // Each result is bound in its own statement, so the operand
+        // temporaries are gone before the result's buffer is inspected.
+        let version = from_oracle_version;
+        let party = from_oracle_party(&party);
+        let mut excess = Vec::new();
+
+        let join = &version(&oa) | &version(&ob);
+        excess.extend(retention_excess("join", join));
+        let meet = &version(&oa) & &version(&ob);
+        excess.extend(retention_excess("meet", meet));
+        let join_all = version(&oa).join_all([version(&ob)]);
+        excess.extend(retention_excess("join_all", join_all));
+        let meet_all = version(&oa).meet_all([version(&ob)]);
+        excess.extend(retention_excess("meet_all", meet_all));
+        let mut joined = version(&oa);
+        joined |= &version(&ob);
+        excess.extend(retention_excess("join in place", joined));
+        let mut met = version(&oa);
+        met &= &version(&ob);
+        excess.extend(retention_excess("meet in place", met));
+
+        let mut ticked = version(&oa);
+        ticked.tick(&party);
+        excess.extend(retention_excess("tick", ticked));
+        let mut ticked = version(&oa);
+        ticked.ticks(&party, count);
+        excess.extend(retention_excess("ticks", ticked));
+
+        let projection = (&version(&oa) / &party).to_version();
+        excess.extend(retention_excess("projection", projection));
+
+        prop_assert!(excess.is_empty(), "{}", excess.join("; "));
+    }
+}
