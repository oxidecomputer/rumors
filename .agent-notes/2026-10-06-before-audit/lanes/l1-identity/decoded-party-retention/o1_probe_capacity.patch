+// TEMPORARY auditor-o1 probe: not for commit.
+/// Print #106's capacity reading for parties taken from decoded clocks.
+#[test]
+fn o1_probe_capacity() {
+    use crate::{Clock, Version};
+    struct Plain<'a>(&'a [u8]);
+    impl std::io::Read for Plain<'_> {
+        fn read(&mut self, buf: &mut [u8]) -> std::io::Result<usize> {
+            self.0.read(buf)
+        }
+    }
+    let show = |case: &str, d: usize, n: usize, party: Party| {
+        let encoded = party.as_bytes().len();
+        let verdict = spare_capacity(case, party).unwrap_or_else(|| format!("{case}: exact"));
+        println!("O1CAP | d={d:>6} | clock={n:>6} B | own={encoded:>6} B | {verdict}");
+    };
+    let party_of = |c: Clock| c.into_parts().0;
+    for depth in [100usize, 1_000, 10_000, 100_000] {
+        let cell = || Party::from_test_bits(constructed::leftmost(depth));
+        let complement = || Party::from_test_bits(constructed::complement_leftmost(depth));
+        let mut version = Version::new();
+        cell().ticks(&mut version, 2u8);
+        let cb = Clock::from_parts(Party::seed(), version.clone()).encode();
+        let n = cb.len();
+
+        show("decode(&[u8]) into_parts", depth, n, party_of(Clock::decode(&cb[..]).unwrap()));
+        show("decode(plain) into_parts", depth, n, party_of(Clock::decode(Plain(&cb)).unwrap()));
+        let mut ticked = Clock::decode(&cb[..]).unwrap();
+        ticked.tick();
+        show("tick then into_parts", depth, n, party_of(ticked));
+        let mut forked = Clock::decode(&cb[..]).unwrap();
+        let child = forked.fork();
+        show("fork kept", depth, n, party_of(forked));
+        show("fork child", depth, n, party_of(child));
+
+        let cell_cb = Clock::from_parts(cell(), version.clone()).encode();
+        let comp_cb = Clock::from_parts(complement(), version.clone()).encode();
+        let mut a = Clock::decode(&cell_cb[..]).unwrap();
+        let mut b = Clock::decode(&comp_cb[..]).unwrap();
+        a.sync(&mut b).unwrap();
+        show("sync receiver", depth, comp_cb.len(), party_of(a));
+        show("sync other", depth, comp_cb.len(), party_of(b));
+        let mut residual = Clock::decode(&comp_cb[..]).unwrap();
+        let shares: Vec<Clock> = residual.forks(1u8).collect();
+        show("forks(1) residual", depth, comp_cb.len(), party_of(residual));
+        for share in shares {
+            show("forks(1) share", depth, comp_cb.len(), party_of(share));
+        }
+        let mut idle = Clock::decode(&comp_cb[..]).unwrap();
+        assert_eq!(idle.forks(0u8).count(), 0);
+        show("forks(0) residual", depth, comp_cb.len(), party_of(idle));
+    }
+}
