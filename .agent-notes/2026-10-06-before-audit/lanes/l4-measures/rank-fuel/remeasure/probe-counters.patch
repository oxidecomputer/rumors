+/// PROBE (rank-sum-remeasure): bitset words visited or written.
+pub static PROBE_BITSET_WORDS: AtomicU64 = AtomicU64::new(0);
+/// PROBE: bitset insertions.
+pub static PROBE_BITSET_INSERTS: AtomicU64 = AtomicU64::new(0);
+/// PROBE: bitset removals.
+pub static PROBE_BITSET_REMOVES: AtomicU64 = AtomicU64::new(0);
+/// PROBE: bitset predecessor queries.
+pub static PROBE_BITSET_QUERIES: AtomicU64 = AtomicU64::new(0);
+/// PROBE: spans that start beside the run.
+pub static PROBE_BESIDE: AtomicU64 = AtomicU64::new(0);
+/// PROBE: prefix-to-bitset conversions.
+pub static PROBE_CONVERT: AtomicU64 = AtomicU64::new(0);
+/// PROBE: digits zero-filled by `add_at` growing the buffer.
+pub static PROBE_FILLED: AtomicU64 = AtomicU64::new(0);
+/// PROBE: shifts of a digit-form value.
+pub static PROBE_SHIFTS: AtomicU64 = AtomicU64::new(0);
+/// PROBE: descents from a zero top digit.
+pub static PROBE_DESCENTS: AtomicU64 = AtomicU64::new(0);
+
+/// PROBE: add `count` to `counter`.
+pub(crate) fn probe(counter: &AtomicU64, count: u64) {
+    counter.fetch_add(count, Ordering::Relaxed);
+}
+
+/// PROBE: every probe counter, in declaration order, then zero them.
+pub fn probe_take() -> [u64; 9] {
+    [
+        &PROBE_BITSET_WORDS,
+        &PROBE_BITSET_INSERTS,
+        &PROBE_BITSET_REMOVES,
+        &PROBE_BITSET_QUERIES,
+        &PROBE_BESIDE,
+        &PROBE_CONVERT,
+        &PROBE_FILLED,
+        &PROBE_SHIFTS,
+        &PROBE_DESCENTS,
+    ]
+    .map(|counter| counter.swap(0, Ordering::Relaxed))
+}
