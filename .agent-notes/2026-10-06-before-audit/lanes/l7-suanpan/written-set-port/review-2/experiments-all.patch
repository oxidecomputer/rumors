+/// Probe: forms reached through the public API by a write just below the top,
+/// and by the sign-query test's shapes.
+#[test]
+fn probe_forms() {
+    for (name, positions) in [
+        ("top 100, then 99", vec![100u64, 99]),
+        ("top 100, then 98", vec![100, 98]),
+        ("0, then top 100, then 99", vec![0, 100, 99]),
+        ("descending 100, 99, 98, 97", vec![100, 99, 98, 97]),
+        ("shape one gap each side s=100", vec![0, 50, 100]),
+        ("shape several gaps s=100", vec![0, 10, 20, 50, 100]),
+    ] {
+        let mut acc = Accumulator::new();
+        for p in &positions {
+            acc.add_shifted_limbs(32 * p, [1]);
+        }
+        let d = &acc.stored().digits;
+        println!(
+            "PROBE {name}: positions {:?} form {} words {}",
+            d.written_positions(),
+            d.written_form(),
+            d.written_storage_words()
+        );
+    }
+}
+
+/// Probe: the set after a normalizing pass on a value whose floor lies above
+/// one and whose set already holds a bitset.
+#[test]
+fn probe_normalized_form() {
+    let mut acc = Accumulator::new();
+    for p in [5u64, 10, 20, 50, 100] {
+        acc.add_shifted_limbs(32 * p, [1]);
+    }
+    {
+        let stored = acc.stored();
+        let d = &stored.digits;
+        println!("PROBE before read: {:?} form {}", d.written_positions(), d.written_form());
+    }
+    let _ = acc.signed_magnitude();
+    let d = &acc.stored().digits;
+    let positions = d.written_positions();
+    println!(
+        "PROBE after read: first {:?} last {:?} count {} form {}",
+        &positions[..3],
+        positions.last(),
+        positions.len(),
+        d.written_form()
+    );
+}
