+/// Probe: words `last_below` reads for a skip of one position across an
+/// aligned boundary, against a skip of one position inside a word.
+#[test]
+fn probe_last_below_cost_at_aligned_boundaries() {
+    for k in 1..=5u32 {
+        let p = 64usize.pow(k);
+        let mut set = Bitset::default();
+        set.insert(p - 1);
+        set.insert(p);
+        set.insert(p + 1);
+        for (query, expected) in [(p, p - 1), (p + 1, p)] {
+            super::WORDS_READ.with(|c| c.set(0));
+            assert_eq!(set.last_below(query), Some(expected));
+            let words = super::WORDS_READ.with(|c| c.get());
+            println!("PROBE k={k} query={query} answer={expected} d=1 words_read={words}");
+        }
     }
 }
