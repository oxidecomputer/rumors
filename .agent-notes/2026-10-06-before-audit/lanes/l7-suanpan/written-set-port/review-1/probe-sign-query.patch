+/// Reviewer probe: bitset words a sign query allocates on the value 2^(32 s).
+#[test]
+fn review_probe_sign_query_allocates() {
+    for s in [1_000_u64, 10_000, 100_000, 1_000_000] {
+        let mut acc = Accumulator::new();
+        acc.add_shifted_limbs(32 * s, [1]);
+        let before = acc.stored().digits.written_storage_words();
+        let digits_before = acc.stored().digits.retained_len();
+        assert_eq!(acc.sign(), Ordering::Greater);
+        let after = acc.stored().digits.written_storage_words();
+        acc.stored().assert_invariants(&[]);
+        eprintln!(
+            "PROBE s={s}: bitset words before sign {before}, after sign {after}; digit buffer {digits_before}"
+        );
+    }
+}
