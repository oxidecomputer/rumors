--- a/crates/before/wasm32-pins/guest/src/checks.rs
+++ b/crates/before/wasm32-pins/guest/src/checks.rs
@@ -228,6 +228,30 @@ fn suanpan_landing(case: u64) -> Result<(), Failure> {
         // 2^32, one past the largest index a 32-bit `usize` counter can hold.
         // The stream is lazy, so the guest allocates nothing for it.
         4 => accumulator.add_shifted_limbs(0, iter::repeat_n(0, usize::MAX).chain([0, 1])),
+        // SCRATCH probes.
+        5 => accumulator.add_shifted_limbs(0, iter::repeat_n(0u64, 1usize << 31).chain([1])),
+        6 => {
+            accumulator.add_shifted_limbs(0, iter::repeat_n(0u64, usize::MAX).chain([0, 1]));
+            let (sign, limbs) = accumulator.signed_magnitude();
+            let wrapped_to_zero = sign == Ordering::Greater && limbs.as_ref() == [1];
+            return Err(if wrapped_to_zero { Failure::WrongBytes } else { Failure::WrongLength });
+        }
+        9 => accumulator.sub_shifted_limbs(0, iter::repeat_n(0, usize::MAX).chain([0, 1])),
+        10 => accumulator.add_shifted_limbs(0, iter::repeat_n(0, usize::MAX).chain([0, 1 << 32])),
+        11 => {
+            accumulator.add_shifted_limbs(0, iter::repeat_n(0, usize::MAX).chain([0, 0]));
+            return if accumulator.cmp_zero() == Ordering::Equal && accumulator.stored_digit_count() == 1 {
+                Ok(())
+            } else {
+                Err(Failure::WrongValue)
+            };
+        }
+        12 => accumulator.add_shifted_limbs(64, iter::repeat_n(0, usize::MAX).chain([0, 1])),
+        13 => {
+            let a: Vec<u8> = Vec::with_capacity(isize::MAX as usize);
+            let b: Vec<u8> = Vec::with_capacity(isize::MAX as usize);
+            core::hint::black_box((&a, &b));
+        }
         _ => return Err(Failure::InvalidArguments),
     }
 
