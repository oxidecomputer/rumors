+
+/// Rescue census (scratch only): the reach of the pool model's generator
+/// against this suite's generator, on the same metrics.
+mod rescue_census {
+    use super::super::explore_l7::{self as pool, Op, POOL};
+    use super::*;
+    use proptest::strategy::ValueTree;
+    use proptest::test_runner::TestRunner;
+
+    /// Counts over one generator's programs.
+    #[derive(Default, Debug)]
+    struct Tally {
+        programs: u64,
+        steps: u64,
+        redundant2: u64,
+        redundant8: u64,
+        redundant64: u64,
+        max_redundancy: i64,
+        programs_redundant2: u64,
+        query_steps: u64,
+        query_redundant2: u64,
+        operand_uses: u64,
+        operand_redundant2: u64,
+        operand_many_ranges: u64,
+        aliased_operand_uses: u64,
+        many_ranges: u64,
+        max_ranges: usize,
+        programs_many_ranges: u64,
+        extreme_after: u64,
+        programs_extreme: u64,
+        normalize_steps: u64,
+        normalize_on_extreme: u64,
+        shift_steps: u64,
+        shift_on_extreme: u64,
+        redundant_zero: u64,
+        max_digits: usize,
+        digits_over_64: u64,
+        digits_over_512: u64,
+    }
+
+    /// Stored digits beyond the value's exact width; negative when an
+    /// extreme top digit carries the value one digit past its stored width.
+    fn redundancy(acc: &Accumulator, oracle: &BigInt) -> i64 {
+        let exact = oracle.magnitude().bits().div_ceil(32).max(1) as i64;
+        acc.stored_digit_count() as i64 - exact
+    }
+
+    /// Recorded zero ranges and extreme digits, or none in the small form.
+    fn shape(acc: &Accumulator) -> (usize, usize) {
+        if acc.small.is_some() {
+            (0, 0)
+        } else {
+            acc.digits.census()
+        }
+    }
+
+    /// Tally one operand use.
+    fn operand(tally: &mut Tally, acc: &Accumulator, oracle: &BigInt) {
+        tally.operand_uses += 1;
+        if redundancy(acc, oracle) >= 2 {
+            tally.operand_redundant2 += 1;
+        }
+        if shape(acc).0 >= 2 {
+            tally.operand_many_ranges += 1;
+        }
+    }
+
+    /// Tally a receiver's state after a step; returns (redundant2, many, extreme).
+    fn after(tally: &mut Tally, acc: &Accumulator, oracle: &BigInt) -> [bool; 3] {
+        tally.steps += 1;
+        let r = redundancy(acc, oracle);
+        tally.max_redundancy = tally.max_redundancy.max(r);
+        tally.redundant2 += u64::from(r >= 2);
+        tally.redundant8 += u64::from(r >= 8);
+        tally.redundant64 += u64::from(r >= 64);
+        let (ranges, extreme) = shape(acc);
+        tally.max_ranges = tally.max_ranges.max(ranges);
+        tally.many_ranges += u64::from(ranges >= 2);
+        tally.extreme_after += u64::from(extreme > 0);
+        tally.redundant_zero += u64::from(*oracle == BigInt::ZERO && !acc.is_known_zero());
+        let digits = acc.stored_digit_count();
+        tally.max_digits = tally.max_digits.max(digits);
+        tally.digits_over_64 += u64::from(digits > 64);
+        tally.digits_over_512 += u64::from(digits > 512);
+        [r >= 2, ranges >= 2, extreme > 0]
+    }
+
+    /// Close one program's per-program flags.
+    fn close(tally: &mut Tally, flags: [bool; 3]) {
+        tally.programs += 1;
+        tally.programs_redundant2 += u64::from(flags[0]);
+        tally.programs_many_ranges += u64::from(flags[1]);
+        tally.programs_extreme += u64::from(flags[2]);
+    }
+
+    fn merge(flags: &mut [bool; 3], new: [bool; 3]) {
+        for (flag, value) in flags.iter_mut().zip(new) {
+            *flag |= value;
+        }
+    }
+
+    /// Print both generators' tallies over the same number of programs.
+    #[test]
+    fn rescue_census_pool_vs_surface() {
+        let n: u64 = std::env::var("RESCUE_N")
+            .ok()
+            .and_then(|s| s.parse().ok())
+            .unwrap_or(1_000);
+
+        let started = std::time::Instant::now();
+        let mut runner = TestRunner::deterministic();
+        let strategy = pool::arb_program();
+        let mut tally = Tally::default();
+        for _ in 0..n {
+            let ops = strategy.new_tree(&mut runner).unwrap().current();
+            let mut accs: [Accumulator; POOL] = Default::default();
+            let mut oracles: [BigInt; POOL] = Default::default();
+            let mut flags = [false; 3];
+            for op in &ops {
+                let t = op.target();
+                match op {
+                    Op::Acc { t: target, s, .. } => {
+                        operand(&mut tally, &accs[*s], &oracles[*s]);
+                        tally.aliased_operand_uses += u64::from(target == s);
+                    }
+                    Op::SumPool { .. } => {
+                        for i in 0..POOL {
+                            operand(&mut tally, &accs[i], &oracles[i]);
+                        }
+                    }
+                    Op::Normalize { .. } => {
+                        tally.normalize_steps += 1;
+                        tally.normalize_on_extreme += u64::from(shape(&accs[t]).1 > 0);
+                    }
+                    Op::Shl { .. } => {
+                        tally.shift_steps += 1;
+                        tally.shift_on_extreme += u64::from(shape(&accs[t]).1 > 0);
+                    }
+                    Op::CmpZero { .. } | Op::Stable { .. } | Op::StablePool { .. } => {
+                        tally.query_steps += 1;
+                        tally.query_redundant2 += u64::from(redundancy(&accs[t], &oracles[t]) >= 2);
+                    }
+                    _ => {}
+                }
+                pool::apply(&mut accs, &mut oracles, op, "census");
+                let new = after(&mut tally, &accs[t], &oracles[t]);
+                merge(&mut flags, new);
+            }
+            close(&mut tally, flags);
+        }
+        println!(
+            "RESCUE pool n={n} secs={:.1} {tally:?}",
+            started.elapsed().as_secs_f64()
+        );
+
+        let started = std::time::Instant::now();
+        let mut runner = TestRunner::deterministic();
+        let strategy = proptest::collection::vec(arb_step(), 1..=80);
+        let mut tally = Tally::default();
+        for _ in 0..n {
+            let steps = strategy.new_tree(&mut runner).unwrap().current();
+            let mut actual = Accumulator::default();
+            let mut oracle = BigInt::ZERO;
+            let mut trace = Vec::new();
+            let mut flags = [false; 3];
+            for step in steps {
+                match &step.operation {
+                    Operation::Accumulator { operand: o, .. }
+                    | Operation::ShiftedAccumulator { operand: o, .. } => {
+                        let (value, value_oracle) = o.values();
+                        operand(&mut tally, &value, &value_oracle);
+                    }
+                    Operation::Sum { operands, .. } => {
+                        for o in operands {
+                            let (value, value_oracle) = o.values();
+                            operand(&mut tally, &value, &value_oracle);
+                        }
+                    }
+                    Operation::Normalize => {
+                        tally.normalize_steps += 1;
+                        tally.normalize_on_extreme += u64::from(shape(&actual).1 > 0);
+                    }
+                    Operation::Shift { .. } => {
+                        tally.shift_steps += 1;
+                        tally.shift_on_extreme += u64::from(shape(&actual).1 > 0);
+                    }
+                    _ => {}
+                }
+                step.operation.apply(&mut actual, &mut oracle);
+                trace.push(step.operation.tag());
+                let new = after(&mut tally, &actual, &oracle);
+                merge(&mut flags, new);
+                // Every step ends in the property's observations, which query the sign.
+                tally.query_steps += 1;
+                tally.query_redundant2 += u64::from(new[0]);
+                assert_observations(&mut actual, &oracle, step.comparison_bits, &trace);
+            }
+            close(&mut tally, flags);
+        }
+        println!(
+            "RESCUE surface n={n} secs={:.1} {tally:?}",
+            started.elapsed().as_secs_f64()
+        );
+    }
