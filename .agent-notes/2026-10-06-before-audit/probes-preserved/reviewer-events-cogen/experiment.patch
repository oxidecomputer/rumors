 //! Checks that memo slots return the values stored in them, across block
 //! boundaries and out of insertion order.
 
-use super::{Memo, StoredAccumulator};
+use proptest::prelude::*;
+
+use super::{Memo, StoredAccumulator, BLOCK_SLOTS};
 
 /// Values inserted nonsequentially at both edges of three memo blocks are
 /// read back from those same six slots.
@@ -26,3 +28,47 @@ fn selected_out_of_order_values_cross_block_boundaries() {
         assert_eq!(actual, expected, "slot {slot}");
     }
 }
+
+/// One pre-scan's memo traffic: every reserved slot's difference (zero for a
+/// slot the scan leaves unset), and the order in which the scan writes them.
+fn arb_scan() -> impl Strategy<Value = (Vec<i64>, Vec<usize>)> {
+    (0..3 * BLOCK_SLOTS).prop_flat_map(|len| {
+        (
+            proptest::collection::vec(prop_oneof![Just(0i64), -4i64..=4], len),
+            Just((0..len).collect::<Vec<_>>()).prop_shuffle(),
+        )
+    })
+}
+
+proptest! {
+    /// Across consecutive pre-scans sharing one memo, every slot reads back
+    /// exactly the difference its own scan wrote, in any write order: a block
+    /// an earlier, longer scan filled carries nothing into a later scan.
+    #[test]
+    fn consecutive_scans_read_back_only_their_own_differences(
+        scans in proptest::collection::vec(arb_scan(), 1..5),
+    ) {
+        let mut memo = Memo::new();
+        for (differences, order) in scans {
+            memo.begin_scan();
+            for _ in &differences {
+                memo.reserve();
+            }
+            for &slot in &order {
+                if differences[slot] != 0 {
+                    memo.set_link(slot, StoredAccumulator::Small(differences[slot]));
+                }
+            }
+            for (slot, &expected) in differences.iter().enumerate() {
+                // An absent link and a stored zero both mean "no difference".
+                let actual = match memo.take_link(slot) {
+                    None => 0,
+                    Some(StoredAccumulator::Small(value)) => value,
+                    Some(StoredAccumulator::Wide(_)) => panic!("the fixture stores only machine words"),
+                };
+                prop_assert_eq!(actual, expected, "slot {}", slot);
+            }
+            memo.cursor = differences.len();
+        }
+    }
+}
