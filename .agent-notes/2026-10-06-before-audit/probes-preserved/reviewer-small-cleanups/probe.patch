diff --git a/crates/before/src/version/measure/integral/width.rs b/crates/before/src/version/measure/integral/width.rs
index aa12b1d15..80d1c06a8 100644
--- a/crates/before/src/version/measure/integral/width.rs
+++ b/crates/before/src/version/measure/integral/width.rs
@@ -245,6 +245,18 @@ impl DensePart {
     /// `4 * span <= S/8 + 8` exceeds that stream's byte length by at most
     /// eight, and no stored byte length exceeds `isize::MAX`.
     fn new(span: usize) -> Self {
+        PROBE_S.with(|s| {
+            if let Some(s) = s.get() {
+                let bound = s / 32 + 2;
+                assert!(span as u64 <= bound, "PROBE VIOLATION span={span} S={s} bound={bound}");
+                PROBE_MAX.with(|m| {
+                    if span as u64 > m.get() {
+                        m.set(span as u64);
+                        eprintln!("PROBE newmax span={span} S={s} bound={bound}");
+                    }
+                });
+            }
+        });
         let len = span
             .checked_mul(4)
             .expect("4 * span <= S/8 + 8, and a stored stream holds at least S bits");
@@ -280,5 +292,14 @@ pub fn reset_densified_digits() {
     DENSIFIED_DIGITS.store(0, core::sync::atomic::Ordering::Relaxed);
 }
 
+thread_local! {
+    static PROBE_S: core::cell::Cell<Option<u64>> = const { core::cell::Cell::new(None) };
+    static PROBE_MAX: core::cell::Cell<u64> = const { core::cell::Cell::new(0) };
+}
+/// Probe: record the driver's common depth.
+pub fn width_probe_set(s: Option<u64>) {
+    PROBE_S.with(|c| c.set(s));
+}
