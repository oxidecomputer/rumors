 /// Checks that borsh decodes a streamed one-leaf version of height `2^k` and
 /// adopts exactly the streamed bytes as its canonical spelling.
+/// Reviewer probe: `Version::decode` of the wide leaf from an exact in-memory slice.
+fn version_slice_wide_leaf(k: u64) -> Result<(), Failure> {
+    use std::io::Read;
+    let len = (2 * k + 3).div_ceil(8);
+    let mut bytes = vec![0u8; usize::try_from(len).map_err(|_| Failure::InvalidArguments)?];
+    synthesis::wide_leaf_stream(k)?.read_exact(&mut bytes).map_err(|_| Failure::Synthesis)?;
+    let version = Version::decode(&bytes[..]).map_err(|error| match error {
+        before::error::Decode::Io(io) if io.kind() == std::io::ErrorKind::OutOfMemory => Failure::Exhausted,
+        _ => Failure::DecodeRejected,
+    })?;
+    if version.encoded_bits() != 2 * k + 2 {
+        return Err(Failure::WrongLength);
+    }
+    if version.as_bytes() != &bytes[..] {
+        return Err(Failure::WrongBytes);
+    }
+    Ok(())
+}
+
 fn version_borsh_wide_leaf(k: u64) -> Result<(), Failure> {
     let mut stream = synthesis::wide_leaf_stream(k)?;
     let version = Version::deserialize_reader(&mut stream).map_err(|_| Failure::DecodeRejected)?;
