+    eprintln!("probe outcome: {:?}", run(Check::VersionChainSplit, WIDE_LEAF_PAST_LIMIT, DOUBLING_LIMIT));
+}
+
+/// Reviewer probe control: the same split with a 1 MiB head.
+#[test]
+fn reviewer_probe_version_decode_chain_split_small_head() {
+    eprintln!("probe outcome: {:?}", run(Check::VersionChainSplit, WIDE_LEAF_PAST_LIMIT, 1 << 20));
+}
