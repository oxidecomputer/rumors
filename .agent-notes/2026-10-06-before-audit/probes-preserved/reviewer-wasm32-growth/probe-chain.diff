+
+/// Reviewer probe: `Version::decode` of the wide-leaf stream, its first `head`
+/// bytes as a slice chained before the lazily streamed rest.
+fn version_chain_split(k: u64, head: u64) -> Result<(), Failure> {
+    use std::io::Read;
+    let mut stream = synthesis::wide_leaf_stream(k)?;
+    let mut first = vec![0u8; usize::try_from(head).map_err(|_| Failure::InvalidArguments)?];
+    stream.read_exact(&mut first).map_err(|_| Failure::Synthesis)?;
+    let version = Version::decode(first.as_slice().chain(stream)).map_err(|error| match error {
+        before::error::Decode::Io(io) if io.kind() == std::io::ErrorKind::OutOfMemory => Failure::Exhausted,
+        _ => Failure::DecodeRejected,
+    })?;
+    if version.encoded_bits() != 2 * k + 2 {
+        return Err(Failure::WrongLength);
+    }
+    Ok(())
+}
