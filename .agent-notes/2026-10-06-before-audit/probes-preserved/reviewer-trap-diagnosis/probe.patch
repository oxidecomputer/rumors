--- a/crates/before/wasm32-pins/guest/src/checks.rs
+++ b/crates/before/wasm32-pins/guest/src/checks.rs
@@ -27,6 +27,7 @@ pub fn run(check: Check, a: u64, b: u64) -> Result<(), Failure> {
         Check::RankArithmetic => rank_arithmetic(a),
         Check::SuanpanLanding => suanpan_landing(a),
         Check::HarnessAllocationFailure => exhaust_memory(),
+        Check::Probe => review_probe(a),
     }
 }
 
@@ -257,3 +258,54 @@ fn suanpan_landing(case: u64) -> Result<(), Failure> {
     // landing position returns a small digit count, so a normal return is red.
     Err(Failure::WrongValue)
 }
+
+/// REVIEW PROBE (temporary): fills memory without aborting.
+fn review_fill() -> Vec<Vec<u8>> {
+    let mut held: Vec<Vec<u8>> = Vec::with_capacity(4096);
+    let mut size: usize = 1 << 30;
+    while held.len() < held.capacity() {
+        let mut v: Vec<u8> = Vec::new();
+        match v.try_reserve_exact(size) {
+            Ok(()) => held.push(v),
+            Err(_) => {
+                if size == 1 {
+                    break;
+                }
+                size /= 2;
+            }
+        }
+    }
+    held
+}
+
+/// REVIEW PROBE (temporary).
+fn review_probe(mode: u64) -> Result<(), Failure> {
+    if mode == 4 {
+        None::<()>.expect("a nonzero contribution needs an addressable digit position");
+        return Err(Failure::WrongValue);
+    }
+    let held = review_fill();
+    black_box(&held);
+    match mode {
+        0 => panic!("deliberate harness panic"),
+        1 => {
+            None::<()>.expect("a nonzero contribution needs an addressable digit position");
+        }
+        2 => panic!("formatted {}", black_box(7_u32)),
+        3 => {
+            let r = suanpan_landing(1);
+            black_box(&r);
+        }
+        5 => {
+            let mut v: Vec<u8> = Vec::new();
+            return if v.try_reserve_exact(1).is_err() && held.len() < held.capacity() {
+                Ok(())
+            } else {
+                Err(Failure::WrongValue)
+            };
+        }
+        _ => return Err(Failure::InvalidArguments),
+    }
+    black_box(&held);
+    Err(Failure::WrongValue)
+}
