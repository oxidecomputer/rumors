+
+/// REVIEW PROBE (temporary): fills memory without aborting.
+fn review_fill() -> Vec<Vec<u8>> {
+    let mut held: Vec<Vec<u8>> = Vec::with_capacity(4096);
+    let mut size: usize = 1 << 30;
+    while held.len() < held.capacity() {
+        let mut v: Vec<u8> = Vec::new();
+        match v.try_reserve_exact(size) {
+            Ok(()) => held.push(v),
+            Err(_) => {
+                if size == 1 {
+                    break;
+                }
+                size /= 2;
+            }
+        }
+    }
+    held
+}
+
+/// REVIEW PROBE (temporary).
+fn review_probe(mode: u64) -> Result<(), Failure> {
+    let held = review_fill();
+    black_box(&held);
+    match mode {
+        0 => {
+            black_box(None::<u8>).unwrap();
+        }
+        1 => {
+            black_box(Err::<(), u8>(3)).unwrap();
+        }
+        _ => return Err(Failure::InvalidArguments),
+    }
+    black_box(&held);
+    Err(Failure::WrongValue)
+}
