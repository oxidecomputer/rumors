index 61789b88..b46d7756 100644
--- a/crates/before/wasm32-pins/guest/src/checks.rs
+++ b/crates/before/wasm32-pins/guest/src/checks.rs
@@ -27,6 +27,7 @@ pub fn run(check: Check, a: u64, b: u64) -> Result<(), Failure> {
         Check::RankArithmetic => rank_arithmetic(a),
         Check::SuanpanLanding => suanpan_landing(a),
         Check::HarnessAllocationFailure => exhaust_memory(),
+        Check::Probe => review_probe(a),
     }
 }
 
@@ -257,3 +258,24 @@ fn suanpan_landing(case: u64) -> Result<(), Failure> {
     // landing position returns a small digit count, so a normal return is red.
     Err(Failure::WrongValue)
 }
+
+/// REVIEW PROBE (temporary).
+fn review_deep(n: u64) -> u64 {
+    if black_box(n) == 0 {
+        0
+    } else {
+        black_box(review_deep(n - 1)) + 1
+    }
+}
+
+/// REVIEW PROBE (temporary).
+fn review_probe(mode: u64) -> Result<(), Failure> {
+    match mode {
+        0 => {
+            black_box(review_deep(black_box(u64::MAX)));
+        }
+        1 => std::process::abort(),
+        _ => return Err(Failure::InvalidArguments),
+    }
+    Err(Failure::WrongValue)
+}
