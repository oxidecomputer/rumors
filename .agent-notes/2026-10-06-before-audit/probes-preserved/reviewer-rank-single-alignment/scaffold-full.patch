+/// REVIEW SCAFFOLD (temporary): gaps 2^32 - 1, 2^32, 2^32 + 1 against one
+/// operand of exponent 2^32 + 8, on both sides of `aligned`.
+fn review_rank_gap(case: u64) -> Result<(), Failure> {
+    let (text, add) = match case {
+        5 => ("0.000000001", true),
+        6 => ("0.00000001", true),
+        7 => ("0.0000001", true),
+        8 => ("0.000000001", false),
+        9 => ("0.00000001", false),
+        10 => ("0.0000001", false),
+        _ => return Err(Failure::InvalidArguments),
+    };
+    let small: Rank = text.parse().map_err(|_| Failure::Synthesis)?;
+    let deep = Rank::decode(&synthesis::rank((1u64 << 32) + 8)?[..])
+        .map_err(|_| Failure::DecodeRejected)?;
+    if add {
+        let sum = &deep + &small;
+        if sum.checked_sub(&small).as_ref() != Some(&deep) {
+            return Err(Failure::WrongValue);
+        }
+    } else {
+        let difference = small.checked_sub(&deep).ok_or(Failure::WrongValue)?;
+        if &difference + &deep != small {
+            return Err(Failure::WrongValue);
+        }
+    }
+    Ok(())
+}
