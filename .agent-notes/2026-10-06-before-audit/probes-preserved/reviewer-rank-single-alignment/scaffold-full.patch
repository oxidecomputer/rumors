+/// REVIEW SCAFFOLD (temporary): edge probe for the alignment variants.
+#[cfg(test)]
+mod review_edges {
+    use super::Rank;
+    use core::cmp::Ordering;
+
+    /// `+` and `checked_sub` agree with the `Sum` fold and their inverse
+    /// identities over every pair from a grid of integer parts and fraction
+    /// exponents straddling the 32- and 64-bit digit boundaries, zero included.
+    #[test]
+    fn review_rank_alignment_edges() {
+        let long = "1".repeat(70);
+        let integers = ["0", "1", "11", "1011", long.as_str()];
+        let mut texts: Vec<String> = Vec::new();
+        for int in integers {
+            texts.push(int.to_string());
+            for exp in [1usize, 2, 7, 31, 32, 33, 63, 64, 65, 95, 96, 97, 127, 128, 129, 200] {
+                texts.push(format!("{int}.{}1", "0".repeat(exp - 1)));
+                texts.push(format!("{int}.{}", "1".repeat(exp)));
+                if exp > 2 {
+                    texts.push(format!("{int}.1{}1", "0".repeat(exp - 2)));
+                }
+            }
+        }
+        let ranks: Vec<Rank> = texts.iter().map(|t| t.parse().expect(t)).collect();
+        let mut pairs = 0u64;
+        for a in &ranks {
+            for b in &ranks {
+                let sum = a + b;
+                let fold: Rank = [a, b].into_iter().sum();
+                assert_eq!(sum, fold, "{a} + {b}");
+                assert_eq!(sum.checked_sub(b).as_ref(), Some(a), "({a} + {b}) - {b}");
+                assert_eq!(sum.checked_sub(a).as_ref(), Some(b), "({a} + {b}) - {a}");
+                match a.cmp(b) {
+                    Ordering::Less => assert!(a.checked_sub(b).is_none()),
+                    Ordering::Equal => assert_eq!(a.checked_sub(b), Some(Rank::ZERO)),
+                    Ordering::Greater => {
+                        let d = a.checked_sub(b).expect("greater");
+                        assert!(d > Rank::ZERO);
+                        assert_eq!(&d + b, *a, "({a} - {b}) + {b}");
+                    }
+                }
+                pairs += 1;
+            }
+        }
+        eprintln!("REVIEW_EDGES pairs={pairs} variant={}", super::REVIEW_VARIANT as char);
+    }
+}
