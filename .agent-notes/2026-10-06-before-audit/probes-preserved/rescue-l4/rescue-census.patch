+
+/// Instrument-rescue census (scratch worktree only, never committed): the
+/// regimes the L4 pair generator reaches beside the committed generators that
+/// feed the same measures.
+mod rescue_census {
+    use super::*;
+    use crate::testing::generators::arb_oracle_version;
+    use crate::testing::optrace;
+    use crate::Clock;
+    use proptest::strategy::ValueTree;
+    use proptest::test_runner::TestRunner;
+
+    /// Tallies of one generator's pairs.
+    #[derive(Default)]
+    struct Tally {
+        cases: u64,
+        froze: u64,
+        deferred: u64,
+        multi: u64,
+        ties: u64,
+        frozen_ties: u64,
+        equal: u64,
+        less: u64,
+        greater: u64,
+        concurrent: u64,
+        depth: Vec<u64>,
+        leaves: Vec<u64>,
+        bits: Vec<u64>,
+        bytes: Vec<u64>,
+    }
+
+    impl Tally {
+        /// Runs the coverage census's operations on one ordered pair.
+        fn pair(&mut self, a: &Version, b: &Version) {
+            let (f0, d0) = (freeze_hits(), defer_hits());
+            let _ = a.rank();
+            let _ = a.distance(b);
+            let tie = a != b && a.rank_cmp(b) == Ordering::Equal;
+            let (f1, d1) = (freeze_hits(), defer_hits());
+            self.cases += 1;
+            self.froze += u64::from(f1 > f0);
+            self.deferred += u64::from(d1 > d0);
+            self.multi += u64::from(d1 >= d0 + 3);
+            self.ties += u64::from(tie);
+            self.frozen_ties += u64::from(tie && f1 > f0);
+            match a.partial_cmp(b) {
+                Some(Ordering::Equal) => self.equal += 1,
+                Some(Ordering::Less) => self.less += 1,
+                Some(Ordering::Greater) => self.greater += 1,
+                None => self.concurrent += 1,
+            }
+        }
+
+        /// Records one version's shape.
+        fn shape(&mut self, depth: u64, leaves: u64, bits: u64, bytes: u64) {
+            self.depth.push(depth);
+            self.leaves.push(leaves);
+            self.bits.push(bits);
+            self.bytes.push(bytes);
+        }
+
+        fn report(&mut self, name: &str) {
+            let pct = |x: u64| 100.0 * x as f64 / self.cases.max(1) as f64;
+            eprintln!(
+                "CENSUS {name}: pairs {} froze {} ({:.1}%) deferred {} ({:.1}%) defer>=3 {} ({:.1}%) distinct-rank-ties {} ({:.1}%) frozen-ties {} ({:.1}%)",
+                self.cases,
+                self.froze,
+                pct(self.froze),
+                self.deferred,
+                pct(self.deferred),
+                self.multi,
+                pct(self.multi),
+                self.ties,
+                pct(self.ties),
+                self.frozen_ties,
+                pct(self.frozen_ties),
+            );
+            eprintln!(
+                "CENSUS {name}: relation equal {} ({:.1}%) less {} ({:.1}%) greater {} ({:.1}%) concurrent {} ({:.1}%)",
+                self.equal,
+                pct(self.equal),
+                self.less,
+                pct(self.less),
+                self.greater,
+                pct(self.greater),
+                self.concurrent,
+                pct(self.concurrent),
+            );
+            for (label, values) in [
+                ("depth", &mut self.depth),
+                ("leaves", &mut self.leaves),
+                ("height-bits", &mut self.bits),
+                ("encoded-bytes", &mut self.bytes),
+            ] {
+                values.sort_unstable();
+                let at = |q: usize| values[(values.len() - 1) * q / 100];
+                eprintln!(
+                    "CENSUS {name}: {label} n {} min {} p50 {} p90 {} p99 {} max {}",
+                    values.len(),
+                    values[0],
+                    at(50),
+                    at(90),
+                    at(99),
+                    values[values.len() - 1]
+                );
+            }
+        }
+    }
+
+    /// Depth, leaf count, and widest absolute height of an oracle tree,
+    /// walked with an explicit stack.
+    fn tree_shape(t: &V) -> (u64, u64, u64) {
+        let mut stack = vec![(t.clone(), 0u64, BigUint::ZERO)];
+        let (mut depth, mut leaves, mut bits) = (0u64, 0u64, 0u64);
+        while let Some((node, d, base)) = stack.pop() {
+            match node {
+                V::Leaf(n) => {
+                    depth = depth.max(d);
+                    leaves += 1;
+                    bits = bits.max((base + n).bits());
+                }
+                V::Node(n, l, r) => {
+                    let b = base + n;
+                    stack.push(((*l).clone(), d + 1, b.clone()));
+                    stack.push(((*r).clone(), d + 1, b));
+                }
+            }
+        }
+        (depth, leaves, bits)
+    }
+
+    const PAIRS: usize = 2000;
+
+    /// The L4 pair generator at its default settings.
+    #[test]
+    fn rescue_census_l4_pairs() {
+        let mut runner = TestRunner::deterministic();
+        let strat = arb_leaves(64).prop_flat_map(arb_related);
+        let mut tally = Tally::default();
+        for _ in 0..PAIRS {
+            let (la, lb) = strat.new_tree(&mut runner).unwrap().current();
+            let (a, b) = (version_of(&la), version_of(&lb));
+            tally.pair(&a, &b);
+            tally.shape(
+                la.iter().map(|l| l.depth).max().unwrap_or(0),
+                la.len() as u64,
+                la.iter().map(|l| l.height.bits()).max().unwrap_or(0),
+                a.encode().len() as u64,
+            );
+        }
+        tally.report("l4-arb_leaves(64)+arb_related");
+    }
+
+    /// The committed `arbitrary_trees_agree` input: two independent
+    /// `arb_oracle_version` draws.
+    #[test]
+    fn rescue_census_committed_arbitrary_pairs() {
+        let mut runner = TestRunner::deterministic();
+        let strat = (arb_oracle_version(), arb_oracle_version());
+        let mut tally = Tally::default();
+        for _ in 0..PAIRS {
+            let (oa, ob) = strat.new_tree(&mut runner).unwrap().current();
+            let (a, b) = (from_oracle_version(&oa), from_oracle_version(&ob));
+            tally.pair(&a, &b);
+            let (d, l, h) = tree_shape(&oa);
+            tally.shape(d, l, h, a.encode().len() as u64);
+        }
+        tally.report("committed-arb_oracle_version-pairs");
+    }
+
+    /// The committed `organic_histories_agree` input: every ordered pair of
+    /// one history's clocks.
+    #[test]
+    fn rescue_census_committed_organic_pairs() {
+        let mut runner = TestRunner::deterministic();
+        let strat = optrace::world_strategy_up_to(40);
+        let mut tally = Tally::default();
+        for _ in 0..500 {
+            let ops = strat.new_tree(&mut runner).unwrap().current();
+            let mut clocks = vec![Clock::seed()];
+            for op in &ops {
+                optrace::step_impl(&mut clocks, op);
+            }
+            for c in &clocks {
+                let (d, l, h) = tree_shape(&to_oracle_version(c.version()));
+                tally.shape(d, l, h, c.version().encode().len() as u64);
+                for other in &clocks {
+                    tally.pair(c.version(), other.version());
+                }
+            }
+        }
+        tally.report("committed-organic-history-pairs");
+    }
+}
