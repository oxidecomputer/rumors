+
+/// Instrument-rescue census (scratch worktree only, never committed): the
+/// rank regimes the L4 generator reaches beside the committed law driver.
+mod rescue_census {
+    use super::*;
+    use proptest::strategy::ValueTree;
+    use proptest::test_runner::TestRunner;
+
+    /// A verbatim copy of `version/tests.rs`'s private `stream_rank`, the
+    /// generator behind the committed `RANK_TRIPLE` law driver.
+    fn stream_rank(next: &mut impl FnMut() -> u64) -> Rank {
+        let limbs = match next() % 8 {
+            0..=3 => 1,
+            4..=5 => 1 + (next() % 4) as usize,
+            6 => 8 + (next() % 8) as usize,
+            _ => 64 + (next() % 200) as usize,
+        };
+        let mut words: Vec<u64> = (0..limbs)
+            .map(|_| match next() % 4 {
+                0 => u64::MAX,
+                1 => 0,
+                _ => next(),
+            })
+            .collect();
+        if let Some(top) = words.last_mut() {
+            if *top == 0 {
+                *top = 1;
+            }
+        }
+        words[0] |= 1;
+        let bytes: Vec<u8> = words.iter().flat_map(|w| w.to_le_bytes()).collect();
+        let num = BigUint::from_bytes_le(&bytes);
+        let exp = next() % 100_000;
+        Rank::from_raw(num, exp)
+    }
+
+    /// Tallies of one generator's rank pairs.
+    #[derive(Default)]
+    struct Tally {
+        ranks: u64,
+        pairs: u64,
+        zero: u64,
+        integral_nonzero: u64,
+        even_integral: u64,
+        word_edge: u64,
+        equal_pairs: u64,
+        same_exp_pairs: u64,
+        exp: Vec<u64>,
+        bits: Vec<u64>,
+        text: Vec<u64>,
+    }
+
+    /// Numerator widths one bit either side of a 32-bit digit or 64-bit limb
+    /// boundary, up to 257 bits.
+    fn at_word_edge(bits: u64) -> bool {
+        bits > 0 && bits <= 257 && matches!(bits % 32, 0 | 1 | 31)
+    }
+
+    impl Tally {
+        fn rank(&mut self, r: &Rank) {
+            let (num, exp) = r.raw_parts();
+            self.ranks += 1;
+            self.zero += u64::from(*num == BigUint::ZERO);
+            let integral = exp == 0 && *num != BigUint::ZERO;
+            self.integral_nonzero += u64::from(integral);
+            self.even_integral += u64::from(integral && !num.bit(0));
+            self.word_edge += u64::from(at_word_edge(num.bits()));
+            self.exp.push(exp);
+            self.bits.push(num.bits());
+            let integer_len = num.bits().saturating_sub(exp).max(1);
+            self.text
+                .push(integer_len + if exp == 0 { 0 } else { exp + 1 });
+        }
+
+        fn pair(&mut self, a: &Rank, b: &Rank) {
+            self.rank(a);
+            self.rank(b);
+            self.pairs += 1;
+            self.equal_pairs += u64::from(a == b);
+            self.same_exp_pairs += u64::from(a.raw_parts().1 == b.raw_parts().1);
+        }
+
+        fn report(&mut self, name: &str) {
+            let of_ranks = |x: u64| 100.0 * x as f64 / self.ranks.max(1) as f64;
+            let of_pairs = |x: u64| 100.0 * x as f64 / self.pairs.max(1) as f64;
+            eprintln!(
+                "RCENSUS {name}: ranks {} zero {:.2}% integral-nonzero {:.2}% even-integral {:.2}% word-edge-width {:.2}%",
+                self.ranks,
+                of_ranks(self.zero),
+                of_ranks(self.integral_nonzero),
+                of_ranks(self.even_integral),
+                of_ranks(self.word_edge),
+            );
+            eprintln!(
+                "RCENSUS {name}: pairs {} equal-value {:.2}% same-exponent {:.2}%",
+                self.pairs,
+                of_pairs(self.equal_pairs),
+                of_pairs(self.same_exp_pairs),
+            );
+            for (label, values) in [
+                ("exponent", &mut self.exp),
+                ("numerator-bits", &mut self.bits),
+                ("text-chars", &mut self.text),
+            ] {
+                values.sort_unstable();
+                let at = |q: usize| values[(values.len() - 1) * q / 100];
+                eprintln!(
+                    "RCENSUS {name}: {label} min {} p50 {} p90 {} p99 {} max {}",
+                    values[0],
+                    at(50),
+                    at(90),
+                    at(99),
+                    values[values.len() - 1]
+                );
+            }
+        }
+    }
+
+    const PAIRS: usize = 20_000;
+
+    /// The L4 related-pair generator, after the parse route it tests.
+    #[test]
+    fn rescue_census_l4_rank_pairs() {
+        let mut runner = TestRunner::deterministic();
+        let strat = arb_q().prop_flat_map(arb_related_q);
+        let mut tally = Tally::default();
+        for _ in 0..PAIRS {
+            let (qa, qb) = strat.new_tree(&mut runner).unwrap().current();
+            tally.pair(&qa.rank(), &qb.rank());
+        }
+        tally.report("l4-arb_q+arb_related_q");
+    }
+
+    /// The committed law driver: independent seeded ranks, taken in pairs.
+    #[test]
+    fn rescue_census_committed_seeded_rank_pairs() {
+        let mut next = crate::testing::rng::word_stream(0x5EED_CE45_0000_0001);
+        let mut tally = Tally::default();
+        for _ in 0..PAIRS {
+            let a = stream_rank(&mut next);
+            let b = stream_rank(&mut next);
+            tally.pair(&a, &b);
+        }
+        tally.report("committed-stream_rank-pairs");
+    }
+}
