+/// REVIEWER SCRATCH: probe entries for the spill regime; never committed.
+pub mod reviewer_probe {
+    use super::{ev_leaf, ev_leaf_wide, BigUint, BitsWriter, Encoding};
+
+    /// A right spine whose first `wide` levels each step by `2^step_bits`
+    /// and whose next `unit` levels each step by one; every left leaf is 0
+    /// relative to its node, and the deepest right leaf steps by one more.
+    /// `min_ticks` is the deepest leaf's height: `wide·2^b + unit + 1`.
+    pub fn stepped_spine(step_bits: usize, wide: usize, unit: usize) -> Encoding {
+        let step = BigUint::from(1u8) << step_bits;
+        let one = BigUint::from(1u8);
+        let mut bits = BitsWriter::with_capacity(0);
+        bits.push(true);
+        bits.write_gamma(&BigUint::ZERO);
+        ev_leaf(&mut bits, 0);
+        for _ in 0..wide {
+            bits.push(true);
+            bits.write_gamma(&step);
+            ev_leaf(&mut bits, 0);
+        }
+        for _ in 0..unit {
+            bits.push(true);
+            bits.write_gamma(&one);
+            ev_leaf(&mut bits, 0);
+        }
+        ev_leaf_wide(&mut bits, &one);
+        Encoding::from_bits(bits)
+    }
+
+    use core::sync::atomic::{AtomicBool, AtomicU64, Ordering::Relaxed};
+    pub static REPLACE_LIVE: AtomicBool = AtomicBool::new(false);
+    pub static REANCHORS: AtomicU64 = AtomicU64::new(0);
+    pub static COMPONENTS: AtomicU64 = AtomicU64::new(0);
+    pub static LEAF_READ: AtomicU64 = AtomicU64::new(0);
+    pub static OFFSET_ADD: AtomicU64 = AtomicU64::new(0);
+    pub static ADVANCE: AtomicU64 = AtomicU64::new(0);
+    pub static WIDTH_FREEZE: AtomicU64 = AtomicU64::new(0);
+    pub static REANCHOR_RESET: AtomicU64 = AtomicU64::new(0);
+    pub static SETTLE: AtomicU64 = AtomicU64::new(0);
+    pub fn now() -> u64 {
+        #[cfg(feature = "touch-meter")]
+        return suanpan::touch_meter::touches();
+        #[cfg(not(feature = "touch-meter"))]
+        0
+    }
+    pub fn charge(counter: &AtomicU64, t0: u64) {
+        counter.fetch_add(now().wrapping_sub(t0), Relaxed);
+    }
+    pub struct Charge(pub &'static AtomicU64, pub u64);
+    impl Drop for Charge {
+        fn drop(&mut self) {
+            charge(self.0, self.1);
+        }
+    }
+    pub fn reset_phases() {
+        for c in [
+            &REANCHORS,
+            &COMPONENTS,
+            &LEAF_READ,
+            &OFFSET_ADD,
+            &ADVANCE,
+            &WIDTH_FREEZE,
+            &REANCHOR_RESET,
+            &SETTLE,
+        ] {
+            c.store(0, Relaxed);
+        }
+    }
+    pub fn phases() -> [u64; 8] {
+        [
+            &REANCHORS,
+            &COMPONENTS,
+            &LEAF_READ,
+            &OFFSET_ADD,
+            &ADVANCE,
+            &WIDTH_FREEZE,
+            &REANCHOR_RESET,
+            &SETTLE,
+        ]
+        .map(|c| c.load(Relaxed))
+    }
+
+    /// `min_ticks` with only prefix indices below `inline` stored inline.
+    pub fn min_ticks_inline(v: &crate::Version, inline: usize) -> crate::Count {
+        crate::Count::min_ticks_with_inline_prefixes(v, inline)
+    }
+}
