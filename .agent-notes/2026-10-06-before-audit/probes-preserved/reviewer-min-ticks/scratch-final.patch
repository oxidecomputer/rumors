+/// Judge the descending run's control-minus-plunge touch surplus against
+/// [`DESCENDING_PARK_SURPLUS_BAND`], returning the surplus or the failure.
+fn descending_park_surplus(plunge: u64, control: u64) -> Result<i64, String> {
+    let surplus = i64::try_from(control).expect("touch counts fit i64")
+        - i64::try_from(plunge).expect("touch counts fit i64");
+    let (floor, ceiling) = DESCENDING_PARK_SURPLUS_BAND;
+    if surplus < floor {
+        return Err(format!(
+            "seam_plunge: the control-minus-plunge surplus {surplus} fell below its \
+             band floor {floor} — a per-hop read of the surviving residue's width is \
+             back in the cascade (or the parks got cheaper: attribute and re-pin)"
+        ));
+    }
+    if surplus > ceiling {
+        return Err(format!(
+            "seam_plunge: the control-minus-plunge surplus {surplus} exceeds its \
+             band ceiling {ceiling} — the drain parks picked up width, or the hops \
+             got cheaper: attribute and re-pin"
+        ));
+    }
+    Ok(surplus)
+}
+
+/// The surplus band alone fails a plunge that reads the surviving residue's
+/// width at every domination hop, the regression its floor guards.
+///
+/// That regression reads the `r`-digit residue once at each of the `k` hops,
+/// one touch per digit, and leaves the control unchanged, so it adds `k·r`
+/// touches to the plunge. The measured pair must pass the band, and the same
+/// pair with that cost added must fail it. The absolute ceiling is not
+/// consulted, so the band cannot be widened past the regression unnoticed
+/// even while the ceiling would still catch it.
+#[test]
+fn descending_park_surplus_band_fails_a_per_hop_residue_read() {
+    let k = 2 * BOUNDARY_SMALL_K;
+    let plunge = min_ticks_family_run(
+        Shape::SeamPlunge.build2(k, BOUNDARY_CLEARANCE),
+        &descending_boundary_ticks(k, BOUNDARY_CLEARANCE),
+    );
+    let control = min_ticks_family_run(
+        Shape::SeamPlungeControl.build2(k, BOUNDARY_CLEARANCE),
+        &descending_boundary_control_ticks(k, BOUNDARY_CLEARANCE),
     );
+    let surplus = descending_park_surplus(plunge.touches, control.touches)
+        .expect("the measured plunge and control sit inside the band");
+    let per_hop_residue_reads = (k * BOUNDARY_CLEARANCE) as u64;
+    let regressed =
+        descending_park_surplus(plunge.touches + per_hop_residue_reads, control.touches);
     assert!(
-        surplus <= DESCENDING_PARK_SURPLUS_BAND.1,
-        "seam_plunge: the control-minus-plunge surplus {surplus} exceeds its \
-         band ceiling {} — the drain parks picked up width, or the hops got \
-         cheaper: attribute and re-pin",
-        DESCENDING_PARK_SURPLUS_BAND.1,
+        regressed.is_err(),
+        "a per-hop read of the {BOUNDARY_CLEARANCE}-digit residue over {k} hops adds \
+         {per_hop_residue_reads} touches, moving the surplus from {surplus} to {}, \
+         which the band still accepts",
+        surplus - per_hop_residue_reads as i64,
     );
 }
 
