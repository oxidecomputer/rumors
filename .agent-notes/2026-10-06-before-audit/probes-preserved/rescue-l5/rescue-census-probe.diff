+// ───────────── rescue census (scratch measurement; never committed) ─────────────
+
+/// One per-bound demand, in vector terms.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum RescueDm {
+    After,
+    Before,
+    NotBefore,
+    NotStrictlyBefore,
+    NotAfter,
+    NotStrictlyAfter,
+}
+
+fn rescue_n_dm(c: &NClause, vs: &[Vect]) -> Vec<(Vect, RescueDm)> {
+    let at = |i: usize| vs[i % vs.len()].clone();
+    match *c {
+        NClause::After(i) => vec![(at(i), RescueDm::After)],
+        NClause::Before(i) => vec![(at(i), RescueDm::Before)],
+    }
+}
+
+fn rescue_d_dm(c: &DClause, vs: &[Vect]) -> Vec<(Vect, RescueDm)> {
+    let at = |i: usize| vs[i % vs.len()].clone();
+    match *c {
+        DClause::N(n) => rescue_n_dm(&n, vs),
+        DClause::Since(i) | DClause::NotBefore(i) => vec![(at(i), RescueDm::NotBefore)],
+        DClause::StrictlyAfter(i) => vec![(at(i), RescueDm::After), (at(i), RescueDm::NotBefore)],
+        DClause::AfterOrConc(i) => vec![(at(i), RescueDm::NotStrictlyBefore)],
+        DClause::Delta(i, j) => vec![(at(i), RescueDm::NotBefore), (at(j), RescueDm::Before)],
+    }
+}
+
+fn rescue_u_dm(c: &UClause, vs: &[Vect]) -> Vec<(Vect, RescueDm)> {
+    let at = |i: usize| vs[i % vs.len()].clone();
+    match *c {
+        UClause::N(n) => rescue_n_dm(&n, vs),
+        UClause::Until(i) | UClause::NotAfter(i) => vec![(at(i), RescueDm::NotAfter)],
+        UClause::StrictlyBefore(i) => vec![(at(i), RescueDm::Before), (at(i), RescueDm::NotAfter)],
+        UClause::BeforeOrConc(i) => vec![(at(i), RescueDm::NotStrictlyAfter)],
+        UClause::Toward(i, j) => vec![(at(i), RescueDm::After), (at(j), RescueDm::NotAfter)],
+    }
+}
+
+/// The endpoint fold: floors joined, ceilings met, then each bound's
+/// segment-emptying and segment-filling conditions read at the endpoints.
+fn rescue_endpoint_fold(lo: &Vect, hi: &Vect, dms: &[(Vect, RescueDm)]) -> Coverage {
+    let mut floor: Option<Vect> = None;
+    let mut ceil: Option<Vect> = None;
+    let mut holes: Vec<(Vect, RescueDm)> = Vec::new();
+    for (b, d) in dms {
+        match d {
+            RescueDm::After => {
+                floor = Some(match floor {
+                    Some(f) => vjoin(&f, b),
+                    None => b.clone(),
+                })
+            }
+            RescueDm::Before => {
+                ceil = Some(match ceil {
+                    Some(c) => vmeet(&c, b),
+                    None => b.clone(),
+                })
+            }
+            _ => holes.push((b.clone(), *d)),
+        }
+    }
+    let mut full = true;
+    if let Some(f) = &floor {
+        if !vle(f, hi) {
+            return Coverage::Empty;
+        }
+        full &= vle(f, lo);
+    }
+    if let Some(c) = &ceil {
+        if !vle(lo, c) {
+            return Coverage::Empty;
+        }
+        full &= vle(hi, c);
+    }
+    for (b, d) in &holes {
+        let (empties, all) = match d {
+            RescueDm::NotBefore => (vle(hi, b), !vle(lo, b)),
+            RescueDm::NotStrictlyBefore => (vlt(hi, b), !vlt(lo, b)),
+            RescueDm::NotAfter => (vle(b, lo), !vle(b, hi)),
+            RescueDm::NotStrictlyAfter => (vlt(b, lo), !vlt(b, hi)),
+            _ => unreachable!(),
+        };
+        if empties {
+            return Coverage::Empty;
+        }
+        full &= all;
+    }
+    if full {
+        Coverage::Full
+    } else {
+        Coverage::Partial
+    }
+}
+
+/// The number of distinct extremal hole bounds: maximal down-holes or
+/// minimal up-holes, whichever is larger.
+fn rescue_antichain(dms: &[(Vect, RescueDm)]) -> usize {
+    let pick = |up: bool| -> usize {
+        let mut hs: Vec<&Vect> = Vec::new();
+        for (b, d) in dms {
+            let is_up = matches!(d, RescueDm::NotAfter | RescueDm::NotStrictlyAfter);
+            let is_down = matches!(d, RescueDm::NotBefore | RescueDm::NotStrictlyBefore);
+            if (up && is_up) || (!up && is_down) {
+                if !hs.iter().any(|h| *h == b) {
+                    hs.push(b);
+                }
+            }
+        }
+        hs.iter()
+            .filter(|h| !hs.iter().any(|o| if up { vlt(o, h) } else { vlt(h, o) }))
+            .count()
+    };
+    pick(false).max(pick(true))
+}
+
+fn rescue_wide(lo: &Vect, hi: &Vect, bounds: &[Vect]) -> bool {
+    let w = BigUint::from(1u8) << 64u32;
+    let big = |v: &Vect| v.iter().any(|x| *x >= w);
+    big(lo) || big(hi) || bounds.iter().any(big)
+}
+
+/// Classify one exact-coverage check.
+fn rescue_check(
+    pop: &str,
+    pol: &str,
+    lo: &Vect,
+    hi: &Vect,
+    bounds: &[Vect],
+    dms: &[(Vect, RescueDm)],
+    adm: &dyn Fn(&[BigUint]) -> bool,
+    depth: u32,
+) {
+    let Some(want) = census(lo, hi, bounds, adm, 20_000) else {
+        stat(format!("RC {pop} {pol} census-skip"));
+        return;
+    };
+    let fold = rescue_endpoint_fold(lo, hi, dms);
+    stat(format!("RC {pop} {pol} checks"));
+    stat(format!("RC {pop} {pol} census={want:?}"));
+    let mismatch = (fold == Coverage::Empty && want != Coverage::Empty)
+        || (fold == Coverage::Full && want != Coverage::Full)
+        || (want == Coverage::Full && fold != Coverage::Full);
+    if mismatch {
+        stat(format!(
+            "RC {pop} {pol} MISMATCH census={want:?} fold={fold:?}"
+        ));
+    }
+    if want == Coverage::Empty && fold == Coverage::Partial {
+        stat(format!("RC {pop} {pol} refine"));
+        let holes = rescue_antichain(dms);
+        stat(format!("RC {pop} {pol} refine antichain={}", holes.min(5)));
+        if holes >= 2 {
+            stat(format!("RC {pop} {pol} refine antichain>=2"));
+        }
+        if depth >= 5 {
+            stat(format!("RC {pop} {pol} refine depth>=5"));
+        }
+        if rescue_wide(lo, hi, bounds) {
+            stat(format!("RC {pop} {pol} refine wide"));
+        }
+    }
+}
