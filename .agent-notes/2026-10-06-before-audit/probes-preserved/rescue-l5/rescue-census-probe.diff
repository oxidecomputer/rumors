+/// The exhaustive boolean cube's query family, census and fold only (each
+/// polar query once; the cube itself runs each twice, once per fold side).
+fn rescue_cube() {
+    let pop = "cube";
+    let pool: Vec<Vect> = (0u32..16)
+        .map(|b| (0..4).map(|c| BigUint::from((b >> c) & 1)).collect())
+        .collect();
+    let n = pool.len();
+    let mut ns: Vec<NClause> = Vec::new();
+    for i in 0..n {
+        ns.push(NClause::After(i));
+        ns.push(NClause::Before(i));
+    }
+    let mut ds: Vec<DClause> = ns.iter().map(|c| DClause::N(*c)).collect();
+    let mut us: Vec<UClause> = ns.iter().map(|c| UClause::N(*c)).collect();
+    for i in 0..n {
+        ds.push(DClause::Since(i));
+        ds.push(DClause::StrictlyAfter(i));
+        ds.push(DClause::AfterOrConc(i));
+        us.push(UClause::Until(i));
+        us.push(UClause::StrictlyBefore(i));
+        us.push(UClause::BeforeOrConc(i));
+    }
+    let pairs = span_pairs(&pool);
+    for a in 0..ds.len() {
+        for b in a..ds.len() {
+            let cl = [ds[a], ds[b]];
+            if !cl.iter().any(|c| !matches!(c, DClause::N(_))) {
+                continue;
+            }
+            let adm = |v: &[BigUint]| cl.iter().all(|c| c.admits(v, &pool));
+            let bounds: Vec<Vect> = cl.iter().flat_map(|c| c.bounds(&pool)).collect();
+            let d: Vec<(Vect, RescueDm)> = cl.iter().flat_map(|c| rescue_d_dm(c, &pool)).collect();
+            for &(i, j) in &pairs {
+                rescue_check(pop, "down", &pool[i], &pool[j], &bounds, &d, &adm, 2);
+            }
+        }
+    }
+    for a in 0..us.len() {
+        for b in a..us.len() {
+            let cl = [us[a], us[b]];
+            if !cl.iter().any(|c| !matches!(c, UClause::N(_))) {
+                continue;
+            }
+            let adm = |v: &[BigUint]| cl.iter().all(|c| c.admits(v, &pool));
+            let bounds: Vec<Vect> = cl.iter().flat_map(|c| c.bounds(&pool)).collect();
+            let d: Vec<(Vect, RescueDm)> = cl.iter().flat_map(|c| rescue_u_dm(c, &pool)).collect();
+            for &(i, j) in &pairs {
+                rescue_check(pop, "up", &pool[i], &pool[j], &bounds, &d, &adm, 2);
+            }
+        }
+    }
+    for a in 0..ns.len() {
+        for b in a..ns.len() {
+            let cl = [ns[a], ns[b]];
+            let adm = |v: &[BigUint]| cl.iter().all(|c| c.admits(v, &pool));
+            let bounds: Vec<Vect> = cl.iter().flat_map(|c| c.bounds(&pool)).collect();
+            let d: Vec<(Vect, RescueDm)> = cl.iter().flat_map(|c| rescue_n_dm(c, &pool)).collect();
+            for &(i, j) in &pairs {
+                rescue_check(pop, "neutral", &pool[i], &pool[j], &bounds, &d, &adm, 2);
+            }
+        }
+    }
+}
