+/// Census of exact-coverage checks the per-bound endpoint conditions cannot
+/// decide (exact `Empty`, endpoint fold `Partial`), per population.
+#[test]
+#[ignore]
+fn rescue_l5_refine_census() {
+    use proptest::test_runner::{Config, TestRunner};
+    let cases = 256;
+    let run = |name: &str, f: &dyn Fn(&mut TestRunner)| {
+        let mut runner = TestRunner::new(Config::with_cases(cases));
+        f(&mut runner);
+        eprintln!("RC-DONE {name}");
+    };
+    run("uniform", &|r: &mut TestRunner| {
+        r.run(
+            &(
+                arb_world(3, 2..=4),
+                arb_nclauses(),
+                proptest::collection::vec(arb_d(), 1..=5),
+                proptest::collection::vec(arb_u(), 1..=5),
+                any::<u64>(),
+            ),
+            |(w, n, d, u, s)| {
+                rescue_queries("uniform", w, n, d, u, s);
+                Ok(())
+            },
+        )
+        .unwrap()
+    });
+    run("antichain", &|r: &mut TestRunner| {
+        r.run(
+            &(
+                arb_world(3, 1..=3),
+                proptest::collection::vec((0usize..64, any::<bool>()), 2..=8),
+                proptest::collection::vec(arb_n(), 0..=2),
+            ),
+            |(w, h, b)| {
+                rescue_antichains("antichain", w, h, b);
+                Ok(())
+            },
+        )
+        .unwrap()
+    });
+    run("shaped", &|r: &mut TestRunner| {
+        r.run(
+            &(
+                arb_shaped_world(2..=4),
+                arb_nclauses(),
+                proptest::collection::vec(arb_d(), 1..=5),
+                proptest::collection::vec(arb_u(), 1..=5),
+                any::<u64>(),
+            ),
+            |(w, n, d, u, s)| {
+                rescue_queries("shaped", w, n, d, u, s);
+                Ok(())
+            },
+        )
+        .unwrap()
+    });
+    run("shaped-antichain", &|r: &mut TestRunner| {
+        r.run(
+            &(
