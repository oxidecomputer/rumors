+/// `public_queries_match_their_relational_denotation`'s small-grid half,
+/// transcribed: 0..=6 inclusive bounds, 1..=6 down forms, 1..=6 up forms,
+/// every ordered segment of the grid.
+fn rescue_committed_random(
+    bounds: Vec<NClause>,
+    down: Vec<DClause>,
+    up: Vec<UClause>,
+) -> Result<(), TestCaseError> {
+    let pop = "committed-random-grid";
+    let grid = rescue_grid();
+    let mut dq: Vec<DClause> = down;
+    let mut uq: Vec<UClause> = up;
+    for b in &bounds {
+        dq.push(DClause::N(*b));
+        uq.push(UClause::N(*b));
+    }
+    let nadm = |v: &[BigUint]| bounds.iter().all(|c| c.admits(v, &grid));
+    let dadm = |v: &[BigUint]| dq.iter().all(|c| c.admits(v, &grid));
+    let uadm = |v: &[BigUint]| uq.iter().all(|c| c.admits(v, &grid));
+    let nb: Vec<Vect> = bounds.iter().flat_map(|c| c.bounds(&grid)).collect();
+    let db: Vec<Vect> = dq.iter().flat_map(|c| c.bounds(&grid)).collect();
+    let ub: Vec<Vect> = uq.iter().flat_map(|c| c.bounds(&grid)).collect();
+    let nd: Vec<(Vect, RescueDm)> = bounds.iter().flat_map(|c| rescue_n_dm(c, &grid)).collect();
+    let dd: Vec<(Vect, RescueDm)> = dq.iter().flat_map(|c| rescue_d_dm(c, &grid)).collect();
+    let ud: Vec<(Vect, RescueDm)> = uq.iter().flat_map(|c| rescue_u_dm(c, &grid)).collect();
+    stat(format!("RC {pop} cases"));
+    for (i, j) in span_pairs(&grid) {
+        let (lo, hi) = (&grid[i], &grid[j]);
+        rescue_check(pop, "neutral", lo, hi, &nb, &nd, &nadm, 1);
+        rescue_check(pop, "down", lo, hi, &db, &dd, &dadm, 1);
+        rescue_check(pop, "up", lo, hi, &ub, &ud, &uadm, 1);
+    }
+    Ok(())
+}
