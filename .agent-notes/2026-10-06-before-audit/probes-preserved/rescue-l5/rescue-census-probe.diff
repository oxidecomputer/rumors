+/// The committed two-party grid in vector form: cell 0 is one party's
+/// height, cell 1 the other's, each 0..=2.
+fn rescue_grid() -> Vec<Vect> {
+    (0..3u32)
+        .flat_map(|a| (0..3u32).map(move |b| vec![BigUint::from(a), BigUint::from(b)]))
+        .collect()
+}
+
+/// `coverage_is_exact_on_the_two_party_grid`'s family, transcribed; with
+/// `extended`, #61's added queries too.
+fn rescue_committed_grid(pop: &str, extended_family: bool) {
+    let grid = rescue_grid();
+    // Index a * 3 + b: a1 = (1, 0) = 3, b1 = (0, 1) = 1, a1b1 = (1, 1) = 4.
+    let anchors = [3usize, 1, 4];
+    let mut neutral: Vec<Vec<NClause>> = vec![vec![]];
+    let mut down: Vec<Vec<DClause>> = Vec::new();
+    let mut up: Vec<Vec<UClause>> = Vec::new();
+    for &x in &anchors {
+        neutral.push(vec![NClause::After(x)]);
+        neutral.push(vec![NClause::Before(x)]);
+        down.push(vec![DClause::Since(x)]);
+        down.push(vec![DClause::StrictlyAfter(x)]);
+        down.push(vec![DClause::AfterOrConc(x)]);
+        up.push(vec![UClause::NotAfter(x)]);
+        up.push(vec![UClause::StrictlyBefore(x)]);
+        up.push(vec![UClause::BeforeOrConc(x)]);
+        for &y in &anchors {
+            neutral.push(vec![NClause::After(x), NClause::Before(y)]);
+            down.push(vec![DClause::Since(x), DClause::Since(y)]);
+            down.push(vec![DClause::Delta(x, y)]);
+            if extended_family {
+                down.push(vec![DClause::N(NClause::After(x)), DClause::Since(y)]);
+                up.push(vec![UClause::Toward(x, y)]);
+            }
+            up.push(vec![UClause::NotAfter(x), UClause::NotAfter(y)]);
+            up.push(vec![UClause::N(NClause::Before(x)), UClause::NotAfter(y)]);
+            if extended_family {
+                for &z in &anchors {
+                    down.push(vec![DClause::N(NClause::After(x)), DClause::Delta(y, z)]);
+                    up.push(vec![UClause::Toward(x, y), UClause::N(NClause::Before(z))]);
+                }
+            }
+        }
+    }
+    stat(format!(
+        "RC {pop} family neutral={} down={} up={}",
+        neutral.len(),
+        down.len(),
+        up.len()
+    ));
+    for (i, j) in span_pairs(&grid) {
+        let (lo, hi) = (&grid[i], &grid[j]);
+        for q in &neutral {
+            let adm = |v: &[BigUint]| q.iter().all(|c| c.admits(v, &grid));
+            let b: Vec<Vect> = q.iter().flat_map(|c| c.bounds(&grid)).collect();
+            let d: Vec<(Vect, RescueDm)> = q.iter().flat_map(|c| rescue_n_dm(c, &grid)).collect();
+            rescue_check(pop, "neutral", lo, hi, &b, &d, &adm, 1);
+        }
+        for q in &down {
+            let adm = |v: &[BigUint]| q.iter().all(|c| c.admits(v, &grid));
+            let b: Vec<Vect> = q.iter().flat_map(|c| c.bounds(&grid)).collect();
+            let d: Vec<(Vect, RescueDm)> = q.iter().flat_map(|c| rescue_d_dm(c, &grid)).collect();
+            rescue_check(pop, "down", lo, hi, &b, &d, &adm, 1);
+        }
+        for q in &up {
+            let adm = |v: &[BigUint]| q.iter().all(|c| c.admits(v, &grid));
+            let b: Vec<Vect> = q.iter().flat_map(|c| c.bounds(&grid)).collect();
+            let d: Vec<(Vect, RescueDm)> = q.iter().flat_map(|c| rescue_u_dm(c, &grid)).collect();
+            rescue_check(pop, "up", lo, hi, &b, &d, &adm, 1);
+        }
+    }
+}
