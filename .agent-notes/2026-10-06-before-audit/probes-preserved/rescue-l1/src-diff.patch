+/// Explore probe: a distant plan whose remaining count fits a machine word
+/// reports that count exactly, as a narrower-count plan would.
+#[test]
+fn explore_distant_plan_is_exact_once_the_remainder_fits() {
+    let depth = u64::from(usize::BITS) + 2;
+    let count = BigUint::from(1u8) << depth;
+    let party = Party::seed();
+    let mut plan = Plan::new(PartySnapshot::new(&party), Count(count.clone()));
+    // A power-of-two count forks no base path again, so the remainder is
+    // exactly the number of base paths left.
+    plan.index = &count - BigUint::from(5u8);
+    assert_eq!(plan.size_hint(), (5, Some(5)));
+}
