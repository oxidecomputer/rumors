+/// Explore probe: distributions of the committed party generators, measured
+/// with the same statistics as the L1 discovery suite's `generator_stats`.
+#[test]
+fn explore_committed_generator_stats() {
+    use proptest::strategy::{Strategy, ValueTree};
+    use proptest::test_runner::TestRunner;
+    use std::collections::BTreeMap;
+
+    fn bucket(x: usize) -> usize {
+        if x < 4 {
+            x
+        } else {
+            x.next_power_of_two()
+        }
+    }
+    /// depth, encoded bytes, two-child branches, longest unary chain
+    fn stats(p: &Party) -> (usize, usize, usize, usize) {
+        let bytes = p.as_bytes();
+        let total = bytes.len() * 8;
+        let bit = |i: usize| bytes[i / 8] >> (7 - i % 8) & 1 == 1;
+        let (mut pos, mut both, mut longest, mut depth) = (0, 0, 0, 0);
+        // stack of (depth, unary chain length so far)
+        let mut stack = vec![(0usize, 0usize)];
+        while let Some((d, chain)) = stack.pop() {
+            if pos + 2 > total {
+                break;
+            }
+            let (l, r) = (bit(pos), bit(pos + 1));
+            pos += 2;
+            depth = depth.max(d);
+            match (l, r) {
+                (true, true) => {
+                    both += 1;
+                    stack.push((d + 1, 0));
+                    stack.push((d + 1, 0));
+                }
+                (true, false) | (false, true) => {
+                    longest = longest.max(chain + 1);
+                    stack.push((d + 1, chain + 1));
+                }
+                _ => {}
+            }
+        }
+        (depth, bytes.len(), both, longest)
+    }
+    let mut runner = TestRunner::deterministic();
+    let n = 4000;
+    let mut h: [BTreeMap<usize, usize>; 4] = Default::default();
+    let (mut disj, mut cov, mut eq) = (0, 0, 0);
+    for _ in 0..n {
+        let a = from_oracle_party(
+            &arb_oracle_party_nonempty()
+                .new_tree(&mut runner)
+                .unwrap()
+                .current(),
+        );
+        let b = from_oracle_party(
+            &arb_oracle_party_nonempty()
+                .new_tree(&mut runner)
+                .unwrap()
+                .current(),
+        );
+        let (d, by, both, ch) = stats(&a);
+        *h[0].entry(bucket(d)).or_default() += 1;
+        *h[1].entry(bucket(by)).or_default() += 1;
+        *h[2].entry(bucket(both)).or_default() += 1;
+        *h[3].entry(bucket(ch)).or_default() += 1;
+        disj += usize::from(a.is_disjoint(&b));
+        cov += usize::from(a.covers(&b) || b.covers(&a));
+        eq += usize::from(a == b);
+    }
+    println!("committed arb party depth {:?}", h[0]);
+    println!("committed arb party bytes {:?}", h[1]);
+    println!("committed arb party both-branches {:?}", h[2]);
+    println!("committed arb party longest-unary {:?}", h[3]);
+    println!("committed arb pairs: disjoint {disj}/{n} nested {cov}/{n} equal {eq}/{n}");
+
+    // Family lists: how often a join_all family is accepted.
+    let (mut accepted, mut fams) = (0, 0);
+    for _ in 0..n {
+        let (r, items) = arb_party_family().new_tree(&mut runner).unwrap().current();
+        fams += 1;
+        let mut acc = from_oracle_party(&r);
+        accepted += usize::from(acc.join_all(items.iter().map(from_oracle_party)).is_ok());
+    }
+    println!("committed party families: join_all accepted {accepted}/{fams}");
+
+    // Organic populations: live parties after op traces.
+    let mut ho: [BTreeMap<usize, usize>; 3] = Default::default();
+    let mut pops: BTreeMap<usize, usize> = BTreeMap::new();
+    for _ in 0..1000 {
+        let ops = world_strategy().new_tree(&mut runner).unwrap().current();
+        let cs = run(&ops);
+        *pops.entry(bucket(cs.len())).or_default() += 1;
+        for c in &cs {
+            let p = from_oracle_party(c.trees().0);
+            let (d, by, both, _) = stats(&p);
+            *ho[0].entry(bucket(d)).or_default() += 1;
+            *ho[1].entry(bucket(by)).or_default() += 1;
+            *ho[2].entry(bucket(both)).or_default() += 1;
+        }
+    }
+    println!("organic population sizes {:?}", pops);
+    println!("organic party depth {:?}", ho[0]);
+    println!("organic party bytes {:?}", ho[1]);
+    println!("organic party both-branches {:?}", ho[2]);
+}
