+/// Sizing draft for MB2 part C: the remaining version, ranked, span, and
+/// query entry points at depth 2^18 on both spines.
+#[test]
+fn deep_tree_remaining_surfaces_stack_safety() {
+    use crate::{causally, Ranked, Span};
+    use std::hint::black_box;
+    const DEPTH: usize = 1 << 18;
+    for mut keeper in [deep_left_spine_party(DEPTH), deep_right_spine_party(DEPTH)] {
+        let half = keeper.fork();
+        let mut a = Version::new();
+        keeper.tick(&mut a);
+        let mut b = Version::new();
+        half.tick(&mut b);
+        let mut late = a.clone();
+        late.ticks(&keeper, 3u8);
+        let joined = a.join(&b);
+        let met = a.meet(&b);
+        assert!(met.is_empty());
+        let hull = &a ^ &b;
+        assert_eq!(hull.hi(), &joined);
+        assert_eq!(Version::decode(&a.encode()[..]).expect("canonical"), a);
+        assert_eq!(a.to_string().parse::<Version>().expect("canonical"), a);
+        let ranked_bytes = a.ranked().encode();
+        assert!(Ranked::decode(&ranked_bytes[..]).expect("canonical") == a.ranked());
+        let mut buf = Vec::new();
+        a.ranked().encode_to(&mut buf).expect("Vec writes");
+        assert_eq!(buf, ranked_bytes);
+        assert_eq!(a.encode_rank(), a.ranked().encode_rank());
+        let mut buf = Vec::new();
+        a.encode_rank_to(&mut buf).expect("Vec writes");
+        assert_eq!(buf, a.encode_rank());
+        let own_a = &joined / &keeper;
+        let own_b = &joined / &half;
+        assert!(own_a.partial_cmp(&own_b).is_none());
+        assert!(own_a <= own_a);
+        let span = Span::new(&met, &joined).expect("met <= joined");
+        black_box(span.precedence(&a));
+        assert!(span.contains(&a));
+        assert!(span.contains(span.reborrow()));
+        let tail = Span::new(&a, &late).expect("a <= late");
+        black_box(span.union(&tail));
+        black_box(span.intersect(&tail));
+        black_box(span.join(&tail));
+        black_box(span.meet(&tail));
+        black_box(span.intersect_all([&tail, &span]));
+        black_box(span.join_all([&tail, &span]));
+        black_box(span.meet_all([&tail, &span]));
+        black_box([&span, &tail].into_iter().sum::<Option<Span>>());
+        black_box([&span, &tail].into_iter().product::<Option<Span>>());
+        black_box(causally::until(&a).contains(&late));
+        black_box(causally::strictly_after(&met).contains(&a));
+        black_box(causally::strictly_before(&joined).contains(&a));
+        black_box(causally::delta(&met, &joined).contains(&a));
+        black_box(causally::toward(&met, &joined).contains(&a));
+        black_box(causally::after(&met).contains(&a));
+        black_box(causally::before(&joined).contains(&a));
+        black_box(causally::after(&met).or_concurrent().contains(&a));
+        black_box(causally::before(&joined).or_concurrent().contains(&a));
+        black_box((!causally::after(&joined)).contains(&a));
+        black_box(causally::after(&met).coverage(span.reborrow()));
+        black_box(causally::before(&joined).coverage(span.reborrow()));
+        black_box(causally::until(&a).coverage(span.reborrow()));
+    }
+}
