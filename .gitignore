# Compiled artifacts; derivable from the .tex (tectonic).
results/*.pdf
target/

# Lean build outputs and fetched packages; lake restores from lake-manifest.json.
formal/lean/.lake/

# EventDag analysis dumps (lake exe eventdag); regenerable from the tool.
formal/lean/eventdag-out/

# macOS Finder metadata; never content.
.DS_Store

# Scan/threat-model working state (session scratch, resumable checkpoints)
/.ccsec-state/
/.threat-model-state/

# The kv example's default directories: its shared credentials, and each node's
# bookmark slots.
/kv-credentials/
/kv-bookmarks/
